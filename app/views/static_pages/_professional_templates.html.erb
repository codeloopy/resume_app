<section id="templates" class="bg-white py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-700">Template gallery</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
          Pick a style that fits the role you want, not just the file you need.
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          The free plan gives you strong starting points, and the premium collection opens up more visual range when you want to tailor applications more intentionally.
        </p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 text-sm text-slate-600">
        Free plan: <span class="font-semibold text-slate-900">Modern</span> and <span class="font-semibold text-slate-900">Classic</span>
        <br>
        Premium: <span class="font-semibold text-slate-900">Minimal</span>, <span class="font-semibold text-slate-900">Creative</span>, and <span class="font-semibold text-slate-900">Executive</span>
      </div>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-200/60">
        <div class="relative bg-gradient-to-br from-cyan-50 via-white to-slate-100 p-8">
          <span class="absolute right-6 top-6 rounded-full bg-cyan-600 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white">
            Free
          </span>
          <div class="rounded-[1.75rem] bg-white p-6 shadow-xl">
            <div class="flex items-start justify-between border-b border-slate-200 pb-4">
              <div>
                <div class="h-3 w-36 rounded-full bg-slate-900"></div>
                <div class="mt-2 h-2 w-28 rounded-full bg-slate-300"></div>
              </div>
              <div class="rounded-xl bg-cyan-50 px-3 py-2 text-xs font-semibold text-cyan-700">Modern</div>
            </div>
            <div class="mt-5 grid gap-4 sm:grid-cols-[0.65fr_0.35fr]">
              <div class="space-y-3">
                <div class="h-2 rounded-full bg-slate-200"></div>
                <div class="h-2 w-11/12 rounded-full bg-slate-200"></div>
                <div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
                <div class="pt-2">
                  <div class="mb-3 h-2 w-24 rounded-full bg-cyan-500/30"></div>
                  <div class="space-y-2">
                    <div class="h-2 rounded-full bg-slate-200"></div>
                    <div class="h-2 w-5/6 rounded-full bg-slate-200"></div>
                  </div>
                </div>
              </div>
              <div class="rounded-2xl border border-slate-200 p-4">
                <div class="h-2 w-16 rounded-full bg-slate-800"></div>
                <div class="mt-3 space-y-2">
                  <div class="h-2 rounded-full bg-slate-200"></div>
                  <div class="h-2 rounded-full bg-slate-200"></div>
                  <div class="h-2 w-3/4 rounded-full bg-slate-200"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="p-7">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-2xl font-semibold text-slate-900">Modern Professional</h3>
            <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700">Best for broad applications</span>
          </div>
          <p class="mt-3 text-slate-600">
            A crisp, contemporary layout for candidates who want something current without feeling overly styled.
          </p>
        </div>
      </article>

      <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg shadow-slate-200/60">
        <div class="relative bg-gradient-to-br from-slate-100 via-white to-slate-50 p-8">
          <span class="absolute right-6 top-6 rounded-full bg-slate-800 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-white">
            Free
          </span>
          <div class="rounded-[1.75rem] bg-white p-6 shadow-xl">
            <div class="border-b border-slate-200 pb-4 text-center">
              <div class="mx-auto h-3 w-40 rounded-full bg-slate-900"></div>
              <div class="mx-auto mt-2 h-2 w-24 rounded-full bg-slate-300"></div>
            </div>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="space-y-3 rounded-2xl border border-slate-200 p-4">
                <div class="h-2 w-16 rounded-full bg-slate-700"></div>
                <div class="h-2 rounded-full bg-slate-200"></div>
                <div class="h-2 w-5/6 rounded-full bg-slate-200"></div>
                <div class="h-2 w-3/4 rounded-full bg-slate-200"></div>
              </div>
              <div class="space-y-3 rounded-2xl border border-slate-200 p-4">
                <div class="h-2 w-20 rounded-full bg-slate-700"></div>
                <div class="h-2 rounded-full bg-slate-200"></div>
                <div class="h-2 w-11/12 rounded-full bg-slate-200"></div>
                <div class="h-2 w-2/3 rounded-full bg-slate-200"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="p-7">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-2xl font-semibold text-slate-900">Executive Classic</h3>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">Best for traditional roles</span>
          </div>
          <p class="mt-3 text-slate-600">
            A more formal structure for corporate, finance, operations, and senior-level applications.
          </p>
        </div>
      </article>
    </div>

    <div class="mt-10 rounded-[2rem] border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-indigo-700">Premium collection</p>
          <h3 class="mt-3 text-2xl font-semibold text-slate-900">More visual range when you want to tailor your story.</h3>
        </div>
        <p class="max-w-2xl text-sm leading-7 text-slate-600">
          Premium styles expand beyond basic formatting so you can choose a layout that better matches creative, design-led, or senior-position expectations.
        </p>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
          <div class="bg-gradient-to-br from-slate-100 to-white p-6">
            <div class="rounded-2xl bg-white p-4 shadow-sm">
              <div class="h-2 w-24 rounded-full bg-slate-700"></div>
              <div class="mt-4 space-y-2">
                <div class="h-2 rounded-full bg-slate-200"></div>
                <div class="h-2 w-5/6 rounded-full bg-slate-200"></div>
                <div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
              </div>
            </div>
          </div>
          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h4 class="text-lg font-semibold text-slate-900">Minimal</h4>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">Pro</span>
            </div>
            <p class="mt-2 text-sm text-slate-600">Best for design-conscious candidates who want maximum whitespace and clarity.</p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
          <div class="bg-gradient-to-br from-purple-50 to-white p-6">
            <div class="rounded-2xl border-l-4 border-purple-500 bg-white p-4 shadow-sm">
              <div class="h-2 w-20 rounded-full bg-slate-700"></div>
              <div class="mt-4 space-y-2">
                <div class="h-2 rounded-full bg-slate-200"></div>
                <div class="h-2 w-11/12 rounded-full bg-slate-200"></div>
                <div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
              </div>
            </div>
          </div>
          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h4 class="text-lg font-semibold text-slate-900">Creative</h4>
              <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-semibold text-purple-700">Pro</span>
            </div>
            <p class="mt-2 text-sm text-slate-600">Best for marketing, content, design, and brand roles that reward tasteful visual personality.</p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
          <div class="bg-gradient-to-br from-amber-50 to-white p-6">
            <div class="rounded-2xl bg-white p-4 text-center shadow-sm">
              <div class="mx-auto h-2 w-28 rounded-full bg-slate-700"></div>
              <div class="mt-4 space-y-2">
                <div class="h-2 rounded-full bg-slate-200"></div>
                <div class="mx-auto h-2 w-5/6 rounded-full bg-slate-200"></div>
                <div class="mx-auto h-2 w-3/4 rounded-full bg-slate-200"></div>
              </div>
            </div>
          </div>
          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h4 class="text-lg font-semibold text-slate-900">Executive</h4>
              <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">Pro</span>
            </div>
            <p class="mt-2 text-sm text-slate-600">Best for leadership applications where structure, hierarchy, and polish matter most.</p>
          </div>
        </article>
      </div>
    </div>

    <div class="mt-10 text-center">
      <%= link_to pricing_path, class: "inline-flex items-center rounded-xl bg-slate-900 px-6 py-3 text-base font-semibold text-white transition hover:bg-slate-800" do %>
        View premium templates and pricing
      <% end %>
    </div>
  </div>
</section>
