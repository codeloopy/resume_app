<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 text-white">
  <div class="absolute inset-0 bg-gradient-to-b from-white/5 via-transparent to-transparent"></div>
  <div class="absolute left-1/2 top-0 h-80 w-80 -translate-x-1/2 rounded-full bg-cyan-400/15 blur-3xl"></div>
  <div class="absolute -right-20 top-32 h-72 w-72 rounded-full bg-indigo-400/20 blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 lg:pt-24 lg:pb-28">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.08] px-4 py-2 text-sm font-medium text-slate-200 shadow-lg shadow-slate-950/20 backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          Career command center for job seekers
        </div>

        <h1 class="mt-6 max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
          Build a resume that looks sharp, reads clearly, and gets through ATS.
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
          Create a polished resume, export a clean PDF, share a recruiter-ready link, and improve your application materials without bouncing between disconnected tools.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <%= button_to guest_sign_up_path,
              class: "inline-flex items-center justify-center rounded-xl bg-cyan-400 px-7 py-4 text-base font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-300 cursor-pointer" do %>
            Start building for free
          <% end %>

          <%= link_to "#templates", class: "inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/[0.06] px-7 py-4 text-base font-semibold text-white transition hover:bg-white/[0.12]" do %>
            Explore templates
          <% end %>
        </div>

        <div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-200">
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Free to start</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Unlimited PDF downloads</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">ATS score included</span>
          <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Public resume link</span>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <div class="text-2xl font-semibold text-white">300+</div>
            <p class="mt-1 text-sm text-slate-300">Job seekers have already used the builder.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <div class="text-2xl font-semibold text-white">2 free</div>
            <p class="mt-1 text-sm text-slate-300">Resume templates available before any upgrade.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <div class="text-2xl font-semibold text-white">3 / month</div>
            <p class="mt-1 text-sm text-slate-300">Job match scans included on the free plan.</p>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-0 rounded-[2rem] bg-cyan-400/10 blur-3xl"></div>

        <div class="relative rounded-[2rem] border border-white/10 bg-white/[0.06] p-4 shadow-2xl shadow-slate-950/30 backdrop-blur-xl sm:p-6">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div>
              <p class="text-sm font-medium uppercase tracking-[0.2em] text-cyan-200">Resume Workspace</p>
              <h2 class="mt-1 text-lg font-semibold text-white">Modern Professional</h2>
            </div>
            <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-200">
              Ready to export
            </span>
          </div>

          <div class="mt-6 grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
            <div class="rounded-[1.5rem] bg-white p-6 text-slate-900 shadow-xl">
              <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-5">
                <div>
                  <p class="text-2xl font-semibold">Jordan Lee</p>
                  <p class="mt-1 text-sm text-slate-500">Product marketer with B2B SaaS experience</p>
                </div>
                <div class="rounded-xl bg-slate-100 px-3 py-2 text-right">
                  <div class="text-xs uppercase tracking-[0.2em] text-slate-500">Template</div>
                  <div class="mt-1 text-sm font-semibold text-slate-900">Modern</div>
                </div>
              </div>

              <div class="mt-5 flex flex-wrap gap-2 text-xs font-medium text-slate-600">
                <span class="rounded-full bg-slate-100 px-3 py-1">Growth</span>
                <span class="rounded-full bg-slate-100 px-3 py-1">Lifecycle</span>
                <span class="rounded-full bg-slate-100 px-3 py-1">Positioning</span>
              </div>

              <div class="mt-6 space-y-5">
                <div>
                  <div class="mb-2 h-2 w-24 rounded-full bg-cyan-500/30"></div>
                  <div class="space-y-2">
                    <div class="h-2 rounded-full bg-slate-200"></div>
                    <div class="h-2 w-11/12 rounded-full bg-slate-200"></div>
                    <div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
                  </div>
                </div>

                <div>
                  <div class="mb-2 h-2 w-28 rounded-full bg-indigo-500/30"></div>
                  <div class="space-y-3">
                    <div class="rounded-2xl border border-slate-200 p-3">
                      <div class="flex items-center justify-between">
                        <div class="h-2 w-32 rounded-full bg-slate-800"></div>
                        <div class="h-2 w-20 rounded-full bg-slate-300"></div>
                      </div>
                      <div class="mt-3 space-y-2">
                        <div class="h-2 rounded-full bg-slate-200"></div>
                        <div class="h-2 w-5/6 rounded-full bg-slate-200"></div>
                      </div>
                    </div>
                    <div class="rounded-2xl border border-slate-200 p-3">
                      <div class="flex items-center justify-between">
                        <div class="h-2 w-28 rounded-full bg-slate-800"></div>
                        <div class="h-2 w-16 rounded-full bg-slate-300"></div>
                      </div>
                      <div class="mt-3 space-y-2">
                        <div class="h-2 rounded-full bg-slate-200"></div>
                        <div class="h-2 w-4/5 rounded-full bg-slate-200"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="space-y-4">
              <div class="rounded-[1.5rem] border border-white/10 bg-slate-900/80 p-5">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-medium text-slate-300">ATS score</p>
                    <p class="mt-2 text-4xl font-semibold text-white">92</p>
                  </div>
                  <div class="rounded-2xl bg-emerald-400/10 px-3 py-2 text-sm font-semibold text-emerald-200">
                    Strong
                  </div>
                </div>
                <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/10">
                  <div class="h-full w-[92%] rounded-full bg-gradient-to-r from-cyan-400 to-emerald-400"></div>
                </div>
                <p class="mt-3 text-sm text-slate-300">
                  Clean layout, scannable sections, and keyword-friendly formatting.
                </p>
              </div>

              <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.08] p-5">
                <p class="text-sm font-medium text-slate-200">Job match scan</p>
                <div class="mt-4 space-y-3">
                  <div class="flex items-center justify-between rounded-2xl bg-white/[0.06] px-4 py-3">
                    <span class="text-sm text-slate-200">Lifecycle marketing manager</span>
                    <span class="text-sm font-semibold text-cyan-200">88%</span>
                  </div>
                  <div class="flex items-center justify-between rounded-2xl bg-white/[0.06] px-4 py-3">
                    <span class="text-sm text-slate-200">Growth marketing lead</span>
                    <span class="text-sm font-semibold text-cyan-200">84%</span>
                  </div>
                  <div class="flex items-center justify-between rounded-2xl bg-white/[0.06] px-4 py-3">
                    <span class="text-sm text-slate-200">Product marketing manager</span>
                    <span class="text-sm font-semibold text-cyan-200">91%</span>
                  </div>
                </div>
              </div>

              <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.08] p-5">
                <p class="text-sm font-medium text-slate-200">Share link</p>
                <div class="mt-3 rounded-2xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-slate-300">
                  freeresumebuilderapp.com/r/jordan-lee
                </div>
                <p class="mt-3 text-sm text-slate-300">
                  Send recruiters a clean, public version without attaching extra files.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
