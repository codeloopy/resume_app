<section class="py-20 bg-gradient-to-r from-blue-600 to-indigo-700">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-bold text-white mb-6">
          Stop Getting Rejected.<br>Start Getting Hired.
      </h2>
      <p class="text-xl text-white mb-8 max-w-2xl mx-auto">
          Join over 300 professionals who transformed their careers this month with our free resume builder.
      </p>

      <div class="bg-white/10 backdrop-blur rounded-lg p-6 mb-8 max-w-md mx-auto">
          <div class="text-white font-bold text-lg">100% Free Forever</div>
          <div class="text-white/80 text-sm">No credit card required</div>
      </div>

      <%= link_to new_user_registration_path, class: "bg-white text-blue-600 px-8 py-4 rounded-lg font-bold text-xl hover:bg-gray-100 transition shadow-xl inline-flex items-center animate-bounce", id: "ready-to-start-building-now"  do %>
        Build My Resume Now
        <i class="fas fa-arrow-right ml-3"></i>
      <% end %>

      <div class="mt-6 text-white text-sm">
          ✓ Ready in 10 minutes &nbsp;&nbsp; ✓ ATS-optimized &nbsp;&nbsp; ✓ Instant download
      </div>
  </div>
</section>
