        <li class="flex items-center text-gray-400">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
          Job application tracker <span class="text-xs ml-1">(Pro)</span>
        </li>
      </ul>
      <%= button_to "Get Started Free", guest_sign_up_path, method: :post, form_class: "w-full", class: "w-full py-3 px-6 bg-gray-100 text-gray-800 font-semibold rounded-lg hover:bg-gray-200 transition border-0 cursor-pointer" %>
    </div>
    <% end %>

