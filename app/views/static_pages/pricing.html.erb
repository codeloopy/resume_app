        <li>✓ Unlimited job-description matching</li>
        <li>✓ Cover letter generator + PDF</li>
        <li>✓ Job application tracker</li>
        <li>✓ 3 resumes for 90 days</li>
      </ul>
      <% if user_signed_in? && !current_user.guest? %>
        <%= button_to "Get Job Search Pass", checkout_path(plan: "job_search_pass"), method: :post, form_class: "w-full", form: { data: { turbo: false } }, class: "w-full py-2.5 px-4 bg-amber-600 text-white font-semibold rounded-lg hover:bg-amber-700 transition border-0 cursor-pointer text-sm" %>
