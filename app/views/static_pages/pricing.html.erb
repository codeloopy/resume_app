<div class="max-w-6xl mx-auto px-4 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Simple, Transparent Pricing</h1>
    <p class="text-xl text-gray-600">Start free. Upgrade when you need more.</p>
  </div>

  <div class="grid gap-8 max-w-5xl mx-auto <%= user_signed_in? ? 'md:grid-cols-2' : 'md:grid-cols-3' %>">
    <% unless user_signed_in? %>
    <!-- Free Plan -->
    <div class="bg-white rounded-2xl border-2 border-gray-200 p-8 shadow-sm">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Free*</h2>
      <p class="text-4xl font-bold text-gray-900 mb-6">$0<span class="text-lg font-normal text-gray-500">/forever</span></p>
      <ul class="space-y-4 mb-8">
        <li class="flex items-center text-gray-700">
          <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          2 professional templates (Modern & Classic)
        </li>
        <li class="flex items-center text-gray-700">
          <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Unlimited PDF downloads
        </li>
        <li class="flex items-center text-gray-700">
          <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Public resume link
        </li>
        <li class="flex items-center text-gray-700">
          <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          ATS-optimized
        </li>
      </ul>
      <%= button_to "Get Started Free", guest_sign_up_path, method: :post, form_class: "w-full", class: "w-full py-3 px-6 bg-gray-100 text-gray-800 font-semibold rounded-lg hover:bg-gray-200 transition border-0 cursor-pointer" %>
    </div>
    <% end %>

    <!-- Growth Plan -->
    <div class="bg-gradient-to-br from-white to-green-500 rounded-2xl border-2 border-green-400 p-8 shadow-xl relative">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-green-600 text-white text-sm font-bold px-3 py-1 rounded-full">Growth</div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Growth</h2>
      <p class="text-4xl font-bold text-gray-900 mb-6">$12<span class="text-lg font-normal text-green-800">/year</span></p>
      <ul class="space-y-4 mb-8">
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Everything in Free
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <strong>5 premium templates</strong>
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <strong>2 resumes</strong>
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-green-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Priority support
        </li>
      </ul>
      <% if user_signed_in? && !current_user.guest? %>
        <%= button_to "Get Growth", checkout_path(plan: "growth"), method: :post, form_class: "w-full", form: { data: { turbo: false } }, class: "w-full py-3 px-6 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition border-0 cursor-pointer" %>
      <% else %>
        <%= link_to "Get Growth", new_user_registration_path, class: "block w-full text-center py-3 px-6 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition" %>
      <% end %>
    </div>

    <!-- Pro Plan -->
    <div class="bg-gradient-to-br from-white to-blue-600 rounded-2xl border-2 border-blue-500 p-8 shadow-xl relative">
      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-sm font-bold px-3 py-1 rounded-full">Pro</div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Pro</h2>
      <p class="text-4xl font-bold text-gray-900 mb-6">$99<span class="text-lg font-normal text-blue-800">/year (1 month free)</span></p>
      <ul class="space-y-4 mb-8">
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Everything in Growth
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <strong>Unlimited templates</strong>
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <strong>10 resumes</strong>
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <strong>Resume analytics</strong> (views & downloads)
        </li>
        <li class="flex items-center text-gray-800">
          <svg class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Priority support
        </li>
      </ul>
      <% if user_signed_in? && !current_user.guest? %>
        <%= button_to "Upgrade to Pro", checkout_path(plan: "pro"), method: :post, form_class: "w-full", form: { data: { turbo: false } }, class: "w-full py-3 px-6 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition border-0 cursor-pointer" %>
      <% else %>
        <%= link_to "Upgrade to Pro", new_user_registration_path, class: "block w-full text-center py-3 px-6 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition" %>
      <% end %>
    </div>
  </div>

  <p class="text-center text-gray-500 mt-8 text-sm">Secure payments via Stripe. Cancel anytime.</p>
  <% unless user_signed_in? %>
  <p class="text-center text-gray-500 mt-2 text-sm">* 100% free without registration, resume will be deleted in 24hrs. If you want to save your info, just register—it's still free.</p>
  <% end %>
</div>
