<%= turbo_frame_tag "articles_data_frame" do %>
  <div class="w-full">
    <h3 class="text-lg font-semibold ml-3 text-slate-800">Articles</h3>
  </div>
  <div class="relative flex flex-col w-full h-full overflow-scroll text-gray-700 bg-white shadow-md rounded-lg bg-clip-border">
    <table class="w-full text-left table-auto min-w-max">
      <thead>
        <tr>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">ID</p>
          </th>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">Title</p>
          </th>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">Category</p>
          </th>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">Published At</p>
          </th>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">Created At</p>
          </th>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">Updated At</p>
          </th>
          <th class="p-4 border-b border-slate-300 bg-slate-50">
            <p class="block text-sm font-normal leading-none text-slate-500">Featured</p>
          </th>
        </tr>
      </thead>
      <tbody>
        <% articles.each do |article| %>
        <tr class="hover:bg-slate-50">
          <td class="p-4 border-b border-slate-200">
            <p class="block text-sm text-slate-800">
              <%= article.id %>
            </p>
          </td>
          <td class="p-4 border-b border-slate-200">
            <p class="block text-sm text-slate-800">
              <%= link_to article.title, article_path(article), class: "text-blue-800 underline", data: { turbo: false } %>
            </p>
          </td>
          <td class="p-4 border-b border-slate-200">
            <p class="block text-sm text-slate-800">
              <%= article.category %>
            </p>
          </td>
          <td class="p-4 border-b border-slate-200">
            <p class="block text-sm text-slate-800">
              <%= article.published_at.strftime("%m/%d/%Y") %>
            </p>
          </td>
          <td class="p-4 border-b border-slate-200">
            <a href="#" class="block text-sm font-semibold text-slate-800">
              <%= article.created_at.strftime("%m/%d/%Y") %>
            </a>
          </td>
          <td class="p-4 border-b border-slate-200">
            <p class="block text-sm text-slate-800">
              <%= article.updated_at.strftime("%m/%d/%Y") %>
            </p>
          </td>
          <td class="p-4 border-b border-slate-200">
            <p class="block text-sm text-slate-800">
              <%= article.featured %>
            </p>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-8">
      <%== pagy_nav(pagy, link_extra: 'data-turbo-frame="users_data_frame"') if pagy && pagy.pages > 1 %>
    </div>
  </div>
<% end %>

<p class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition mt-8 inline-block mb-8"><%= link_to "Create a new Article", new_article_path, class: "text-white", data: { turbo: false } %></p>
