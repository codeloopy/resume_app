<h1 class="text-2xl font-bold text-center mb-6">Dashboard</h1>

<%= render "guest_analytics" %>

<%= turbo_frame_tag "articles_data_frame" do %>
  <%= render "articles_data", articles: @articles, pagy: @pagy_articles %>
<% end %>

<%= turbo_frame_tag "users_data_frame" do %>
  <%= render "users_data", users: @users, pagy: @pagy_users %>
<% end %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  <%= turbo_frame_tag "feedback_data_frame" do %>
    <%= render "feedback_data", feedbacks: @feedbacks, pagy: @pagy_feedbacks %>
  <% end %>

  <%= turbo_frame_tag "resume_data_frame" do %>
    <%= render "resume_data", resumes: @resumes, pagy: @pagy_resumes %>
  <% end %>
</div>
