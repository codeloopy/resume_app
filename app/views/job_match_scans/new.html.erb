<div class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">Match Resume to Job</h1>
  <p class="text-gray-600 mb-6">Paste a job description to find keywords your resume is missing.</p>

  <%= form_with model: @scan, url: resume_job_match_scans_path(@resume), class: "space-y-4" do |f| %>
    <div>
      <%= f.label :company_name, "Company (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :company_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :job_title, "Job Title (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :job_title, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :job_description, "Job Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :job_description, rows: 12, required: true, placeholder: "Paste the full job description here...", class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Analyze Match", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg cursor-pointer border-0" %>
      <%= link_to "Cancel", resume_job_match_scans_path(@resume), class: "py-2 px-4 text-gray-600 hover:text-gray-900" %>
    </div>
  <% end %>
</div>
