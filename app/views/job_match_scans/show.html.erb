<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= @scan.display_title %></h1>
    <%= link_to "All Scans", resume_job_match_scans_path(@resume), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
  </div>

  <% score = @result[:match_score] %>
  <% score_color = score >= 70 ? "text-green-600" : score >= 50 ? "text-yellow-600" : "text-red-600" %>

  <div class="bg-white border border-gray-200 rounded-xl p-8 mb-6 text-center">
    <div class="text-5xl font-bold <%= score_color %>"><%= score %>%</div>
    <p class="text-gray-600 mt-2">Match Score</p>
    <p class="text-sm text-gray-500 mt-1">
      <%= @result[:matched_count] %> of <%= @result[:total_job_keywords] %> job keywords found in your resume
    </p>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-green-50 border border-green-200 rounded-xl p-6">
      <h2 class="font-semibold text-green-900 mb-3">Matched Keywords (<%= @result[:matched_keywords].size %>)</h2>
      <% if @result[:matched_keywords].any? %>
        <div class="flex flex-wrap gap-2">
          <% @result[:matched_keywords].each do |keyword| %>
            <span class="bg-green-100 text-green-800 text-sm px-2 py-1 rounded"><%= keyword %></span>
          <% end %>
        </div>
      <% else %>
        <p class="text-green-700 text-sm">No keyword matches found. Try adding more relevant skills and experience.</p>
      <% end %>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
      <h2 class="font-semibold text-amber-900 mb-3">Missing Keywords (<%= @result[:missing_keywords].size %>)</h2>
      <% if @result[:missing_keywords].any? %>
        <div class="flex flex-wrap gap-2">
          <% @result[:missing_keywords].each do |keyword| %>
            <span class="bg-amber-100 text-amber-800 text-sm px-2 py-1 rounded"><%= keyword %></span>
          <% end %>
        </div>
        <p class="text-amber-700 text-sm mt-4">Add relevant missing keywords to your skills or experience bullets to improve your match.</p>
      <% else %>
        <p class="text-amber-700 text-sm">Great match! Your resume covers the key terms from this job description.</p>
      <% end %>
    </div>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "Edit Resume", edit_resume_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition text-sm" %>
    <%= link_to "Scan Another Job", new_resume_job_match_scan_path(@resume), class: "py-2 px-4 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm" %>
  </div>

  <% if score < 70 && !current_user.premium? %>
    <%= render "shared/upgrade_prompt",
          title: "Want AI to tailor your resume?",
          message: "Upgrade to get AI cover letters and unlimited job matching while you apply.",
          cta: "See Plans" %>
  <% end %>
</div>
