<% if user_signed_in? %>
  <% if current_user.guest? %>
    <div class="<%= local_assigns[:mobile] ? 'mobile-menu-link block px-3 py-2 rounded-md text-base font-medium' : 'px-3 py-2 rounded-md text-sm font-medium' %>">
      <span class="text-orange-600 font-medium">Guest Mode</span>
      <%= link_to "Complete Account", upgrade_guest_user_form_path, class: "ml-2 text-blue-600 hover:text-blue-800 underline" %>
    </div>
  <% end %>
  <% if !current_user.guest? %>
    <%= link_to "Edit User", edit_user_registration_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <% end %>
  <% if (nav_resume = @resume || current_user.resume) %>
    <% if current_user.cover_letter_access? %>
      <%= link_to "Cover Letters", resume_cover_letters_path(nav_resume), class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
    <% else %>
      <%= link_to "Cover Letters", pricing_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-500 hover:text-gray-700 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-500 hover:text-gray-700 px-3 py-2 rounded-md text-sm font-medium transition duration-200", title: "Growth & Pro feature" %>
    <% end %>
    <% if current_user.job_application_access? %>
      <%= link_to "Job Tracker", resume_job_applications_path(nav_resume), class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
    <% else %>
      <%= link_to "Job Tracker", pricing_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-500 hover:text-gray-700 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-500 hover:text-gray-700 px-3 py-2 rounded-md text-sm font-medium transition duration-200", title: "Pro feature" %>
    <% end %>
  <% end %>
  <% if current_user.premium? %>
    <%= link_to "My Resumes", resumes_path, class: local_assigns[:mobile] ? "mobile-menu-link bg-blue-600 text-white block px-3 py-2 rounded-md text-base font-medium hover:bg-blue-700 transition duration-200" : "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition duration-200" %>
  <% elsif resume_completed(@resume) && !current_user.guest %>
    <%= link_to "Edit your Resume", edit_resume_path, class: local_assigns[:mobile] ? "mobile-menu-link bg-blue-600 text-white block px-3 py-2 rounded-md text-base font-medium hover:bg-blue-700 transition duration-200" : "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition duration-200" %>
  <% else %>
    <%= link_to "Resume Wizard", resume_wizard_path(:summary), class: local_assigns[:mobile] ? "mobile-menu-link bg-blue-600 text-white block px-3 py-2 rounded-md text-base font-medium hover:bg-blue-700 transition duration-200" : "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition duration-200" %>
  <% end %>
  <%= link_to "Pricing", pricing_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "The Blog", articles_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= button_to "Sign out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200 cursor-pointer" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200 cursor-pointer" %>
<% elsif !current_page?(root_path) %>
  <%#= link_to "Templates", "#{root_path}#templates", class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "Features", "#{root_path}#features", class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "How It Works", "#{root_path}#how-it-works", class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "Pricing", pricing_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "The Blog", articles_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
<% else %>
  <!-- <a href="#templates" class="<%#= local_assigns[:mobile] ? 'mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200' : 'text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200' %>">Templates</a> -->
  <a href="#features" class="<%= local_assigns[:mobile] ? 'mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200' : 'text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200' %>">Features</a>
  <a href="#how-it-works" class="<%= local_assigns[:mobile] ? 'mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200' : 'text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200' %>">How It Works</a>
  <%= link_to "Pricing", pricing_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "The Blog", articles_path, class: local_assigns[:mobile] ? "mobile-menu-link text-gray-600 hover:text-gray-900 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium transition duration-200" : "text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition duration-200" %>
  <%= link_to "Sign In", new_user_session_path, class: local_assigns[:mobile] ? "mobile-menu-link bg-blue-600 text-white block px-3 py-2 rounded-md text-base font-medium hover:bg-blue-700 transition duration-200" : "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition duration-200" %>
<% end %>
