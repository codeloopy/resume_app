<div class="pointer-events-none fixed inset-x-0 top-[5.5rem] z-50 flex justify-center px-4">
<% if notice %>
  <div class="pointer-events-auto mb-4 w-full max-w-xl auto-dismiss-flash rounded-2xl border border-emerald-400/20 bg-slate-950/92 px-5 py-4 text-emerald-100 shadow-2xl shadow-slate-950/30 backdrop-blur" role="alert" data-controller="flash">
    <div class="flex items-start gap-3">
      <span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
      <span class="block sm:inline"><%= notice %></span>
    </div>
  </div>
<% end %>

<% if alert %>
  <div class="pointer-events-auto mb-4 w-full max-w-xl auto-dismiss-flash rounded-2xl border border-rose-400/20 bg-slate-950/92 px-5 py-4 text-rose-100 shadow-2xl shadow-slate-950/30 backdrop-blur" role="alert" data-controller="flash">
    <div class="flex items-start gap-3">
      <span class="mt-1 inline-flex h-2.5 w-2.5 rounded-full bg-rose-400"></span>
      <span class="block sm:inline"><%= alert %></span>
    </div>
  </div>
<% end %>
</div>
<script>
(function() {
  function setupFlashDismiss(element) {
    if (element.dataset.dismissSetup) return;
    element.dataset.dismissSetup = 'true';
    element.style.transition = 'opacity 0.5s ease-out';
    setTimeout(function() {
      if (element && element.parentNode) {
        element.style.opacity = '0';
        setTimeout(function() {
          if (element && element.parentNode) {
            element.remove();
          }
        }, 500);
      }
    }, 3000); // Changed to 3 seconds
  }

  function initFlashDismiss() {
    var flashMessages = document.querySelectorAll('.auto-dismiss-flash');
    flashMessages.forEach(setupFlashDismiss);
  }

  // Run immediately
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFlashDismiss);
  } else {
    initFlashDismiss();
  }

  // Watch for new flash messages with more aggressive observation
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      mutation.addedNodes.forEach(function(node) {
        if (node.nodeType === 1) {
          if (node.classList && node.classList.contains('auto-dismiss-flash')) {
            setupFlashDismiss(node);
          }
          var flashes = node.querySelectorAll && node.querySelectorAll('.auto-dismiss-flash');
          if (flashes) {
            flashes.forEach(setupFlashDismiss);
          }
        }
      });
    });
    // Also check all existing flash messages in case they were missed
    initFlashDismiss();
  });

  // Start observing immediately
  if (document.body) {
    observer.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', function() {
      observer.observe(document.body, { childList: true, subtree: true });
    });
  }

  // Also run on Turbo events
  document.addEventListener('turbo:load', initFlashDismiss);
  document.addEventListener('turbo:render', initFlashDismiss);
  document.addEventListener('turbo:frame-load', initFlashDismiss);

  // Run after a short delay to catch any messages that appear after page load
  setTimeout(initFlashDismiss, 50);
  setTimeout(initFlashDismiss, 200);
  setTimeout(initFlashDismiss, 500);
})();
</script>
