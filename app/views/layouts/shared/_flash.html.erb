<div class="fixed top-5 right-4 z-60 left-1/2 transform -translate-x-1/2">
<% if notice %>
  <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert" data-controller="flash">
    <span class="block sm:inline"><%= notice %></span>
  </div>
<% end %>

<% if alert %>
  <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert" data-controller="flash">
    <span class="block sm:inline"><%= alert %></span>
  </div>
<% end %>
</div>
