<header class="fixed top-0 w-full bg-white/95 backdrop-blur-sm border-b border-gray-100 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-8">
            <a href="/" class="font-bold text-xl text-gray-900"><%= Constants::SITE_NAME %></a>
            <nav class="hidden md:flex items-center space-x-6">
              <a href="/" class="text-gray-600 hover:text-gray-900 transition">Home</a>
            </nav>
          </div>
          <div class="hidden md:flex items-center space-x-4">
            <%= button_to guest_sign_up_path,
              class: "bg-blue-500 text-white px-8 py-4 rounded-lg font-semibold text-lg hover:bg-primary/90 transition shadow-lg flex items-center justify-center cursor-pointer" do %>
              Start Free!
          <% end %>
          </div>
          <button id="mobile-menu-btn" class="md:hidden p-2">
            <i class="fas fa-bars text-gray-600"></i>
          </button>
      </div>
  </div>
  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t">
    <div class="px-4 py-3 space-y-3">
      <a href="/" class="block text-gray-600 hover:text-gray-900">Home</a>
      <a href="/blog" class="block text-primary font-medium">Blog</a>
      <a href="/#templates" class="block text-gray-600 hover:text-gray-900">Templates</a>
      <a href="/resumes/new" class="block bg-primary text-white px-4 py-2 rounded-lg text-center">Start Free</a>
    </div>
  </div>
</header>
