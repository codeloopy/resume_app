<% signed_in_shell = user_signed_in? %>
<nav class="<%= signed_in_shell ? 'theme-nav border-b backdrop-blur-xl' : 'bg-white shadow-sm border-b' %>">
  <div class="site-shell-frame">
    <div class="flex h-[4.5rem] items-center justify-between">
      <div class="flex items-center gap-8">
        <div class="flex-shrink-0">
          <% if current_user&.admin? %>
            <%= link_to "Dashboard", admin_dashboard_path, class: signed_in_shell ? "text-xl font-semibold tracking-tight text-white hover:text-cyan-200" : "text-xl font-bold text-gray-900 hover:text-gray-900" %>
          <% else %>
            <%= link_to root_path, class: "block" do %>
              <span class="<%= signed_in_shell ? 'text-xl font-semibold tracking-tight text-white' : 'text-2xl font-bold text-gray-900' %>"><%= Constants::SITE_NAME %></span>
              <% if signed_in_shell %>
                <span class="mt-1 block text-xs font-medium uppercase tracking-[0.25em] text-slate-400">Workspace</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-2">
          <%= render "layouts/shared/navigation_items" %>
          <% if signed_in_shell %>
            <%= render "layouts/shared/theme_toggle" %>
          <% end %>
        </div>
      </div>

      <div class="md:hidden">
        <button type="button" id="mobile-menu-button" class="<%= signed_in_shell ? 'rounded-xl border border-white/10 bg-white/5 p-2 text-slate-300 hover:bg-white/10 hover:text-white focus:outline-none' : 'p-2 text-gray-600 hover:text-gray-900 focus:outline-none focus:text-gray-900' %>">
          <span class="sr-only">Open main menu</span>
          <svg id="hamburger-icon" class="h-6 w-6 cursor-pointer" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden">
    <div class="<%= signed_in_shell ? 'theme-nav-panel space-y-2 border-t px-4 pb-4 pt-3 backdrop-blur-xl' : 'space-y-1 bg-white border-t px-2 pt-2 pb-3 sm:px-3' %>">
      <% if signed_in_shell %>
        <%= render "layouts/shared/theme_toggle", mobile: true %>
      <% end %>
      <%= render "layouts/shared/navigation_items", mobile: true %>
    </div>
  </div>
</nav>

<%= render "layouts/shared/mobile_menu_js" %>
