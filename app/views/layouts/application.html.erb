<!DOCTYPE html>
<html lang="en">
  <%= render "layouts/shared/head" %>
  <body>
    <%= render "layouts/shared/navigation" %>
    <%= render "layouts/shared/flash" %>

    <% if controller_name == 'static_pages' && action_name == 'home' %>
      <%= yield %>
    <% else %>
      <div class="container mx-auto p-4">
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
