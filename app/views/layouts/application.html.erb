<!DOCTYPE html>
<html lang="en">
  <% homepage = controller_name == "static_pages" && action_name == "home" %>
  <% authenticated_shell = user_signed_in? && !homepage %>
  <%= render "layouts/shared/head" %>
  <body class="theme-page app-shell min-h-screen flex flex-col <%= authenticated_shell ? '' : 'bg-white text-slate-900' %>">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MSVFN92S"
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <%= render "layouts/shared/navigation" %>
    <%= render "layouts/shared/flash" %>

    <main class="app-main flex-1 <%= authenticated_shell ? 'theme-page-gradient' : '' %>">
      <% if homepage %>
        <%= yield %>
      <% elsif authenticated_shell %>
        <div class="site-shell-frame py-8">
          <%= yield %>
        </div>
      <% else %>
        <div class="container mx-auto p-4">
          <%= yield %>
        </div>
      <% end %>
    </main>

    <%= render "shared/footer" %>
    <%= render "layouts/shared/feeback" %>
  </body>
  <%= render "layouts/shared/organization_level_structured_data" %>
</html>
