<!DOCTYPE html>
<html lang="en">
  <%= render "layouts/shared/head" %>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MSVFN92S"
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <%= render "layouts/shared/navigation" %>
    <%= render "layouts/shared/flash" %>

    <% if controller_name == 'static_pages' && action_name == 'home' %>
      <%= yield %>
    <% else %>
      <div class="container mx-auto p-4">
        <%= yield %>
      </div>
    <% end %>

    <%= render "shared/footer" %>
    <%= render "layouts/shared/feeback" %>
  </body>
  <%= render "layouts/shared/organization_level_structured_data" %>
</html>
