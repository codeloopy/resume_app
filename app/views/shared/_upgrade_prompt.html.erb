<%# locals: title:, message:, cta: "Upgrade" %>
<div class="bg-gradient-to-r from-indigo-50 to-purple-50 border border-indigo-200 rounded-xl p-5 mt-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <p class="font-semibold text-indigo-900"><%= title %></p>
      <p class="text-sm text-indigo-700 mt-1"><%= message %></p>
    </div>
    <%= link_to cta, pricing_path, class: "shrink-0 inline-block text-center bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition text-sm" %>
  </div>
</div>
