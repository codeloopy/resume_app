<%= form_with model: @resume, url: resume_wizard_path, method: :put do |f| %>
  <div class="mb-8">
    <h3 class="text-md font-semibold mb-4 text-gray-700">PDF Template Style</h3>
    <%= f.label :pdf_template, "Choose your preferred PDF style", class: "block text-gray-700 font-semibold mb-2" %>
    <%= f.select :pdf_template, pdf_template_options_for_select(@resume.pdf_template), {}, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    <p class="text-sm text-gray-500 mt-1">This will be used when generating your PDF resume</p>
    <% unless current_user&.pro? %>
      <p class="text-sm text-indigo-600 mt-2">
        <%= link_to "Upgrade to Pro", pricing_path, class: "font-medium hover:underline" %> for 3 more premium templates.
      </p>
    <% end %>
  </div>

  <div class="flex justify-between items-center">
    <%= link_to "Previous: Education", resume_wizard_path(:education), class: "text-blue-600 hover:text-blue-800 font-medium" %>
    <%= f.submit "Complete Resume", class: "text-white bg-gradient-to-r from-green-500 via-green-600 to-green-700 hover:bg-gradient-to-br focus:ring-4 focus:outline-none focus:ring-blue-300 dark:focus:ring-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 my-2 inline-block" %>
  </div>
<% end %>
