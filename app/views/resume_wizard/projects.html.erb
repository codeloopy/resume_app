<div class="mx-4 my-4">
  <%= render "progress" %>
  <h1 class="text-2xl font-bold mb-6 text-center">Step 5: Projects</h1>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-4 text-gray-800">Your Projects</h2>
      <p class="text-gray-600 mb-6">Showcase your best work, side projects, and portfolio pieces.</p>
    </div>

    <%= form_with model: @resume, url: resume_wizard_path, method: :put do |f| %>
      <% if @resume.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
          <h3 class="text-red-800 font-medium mb-2">Please fix the following errors:</h3>
          <ul class="text-red-700 text-sm">
            <% @resume.errors.full_messages.each do |message| %>
              <li>• <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <h3 class="text-md font-semibold mb-4 text-gray-700">Project Portfolio</h3>

        <% if @resume.projects.any? %>
          <% @resume.projects.each do |proj| %>
            <div class="mb-4 p-4 border border-gray-200 rounded-lg bg-gray-50">
              <div class="flex justify-between items-start mb-2">
                <h4 class="font-semibold text-gray-800"><%= proj.title %></h4>
                <div class="flex space-x-2">
                  <%= link_to "Edit", edit_project_path(proj), class: "text-blue-600 hover:text-blue-800 text-sm" %>
                  <%= link_to "Delete", project_path(proj), data: { turbo_method: :delete, confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800 text-sm" %>
                </div>
              </div>
              <% if proj.url.present? %>
                <p class="text-sm text-blue-600 mb-2">
                  <%= link_to proj.url, proj.url, target: "_blank", class: "hover:underline" %>
                </p>
              <% end %>
              <% if proj.description.present? %>
                <p class="text-sm text-gray-700"><%= proj.description %></p>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-8 text-gray-500">
            <p>No projects added yet.</p>
          </div>
        <% end %>
      </div>

      <div class="mb-8" data-controller="responsibility" data-responsibility-scope="projects">
        <div data-responsibility-target="container">
          <%= f.fields_for :projects do |proj_form| %>
            <%= render "projects/project_fields", f: proj_form %>
          <% end %>
        </div>

        <div class="mt-4">
          <%= link_to "Add Project", "#", class: "inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition duration-200", data: { action: "click->responsibility#add" } %>
        </div>

        <div hidden data-responsibility-target="template">
          <%= capture do %>
            <%= f.fields_for(:projects, Project.new, child_index: "NEW_RECORD") do |proj_form| %>
              <%= render "projects/project_fields", f: proj_form %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="mb-8">
        <h3 class="text-md font-semibold mb-4 text-gray-700">PDF Template Style</h3>
        <%= f.label :pdf_template, "Choose your preferred PDF style", class: "block text-gray-700 font-semibold mb-2" %>
        <%= f.select :pdf_template, options_for_select(
          [["Modern - Clean and contemporary", "modern"], ["Classic - Traditional and professional", "classic"]],
          @resume.pdf_template
        ), {}, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        <p class="text-sm text-gray-500 mt-1">This will be used when generating your PDF resume</p>
      </div>

      <div class="flex justify-between items-center">
        <%= link_to "Previous: Education", resume_wizard_path(:education), class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <%= f.submit "Complete Resume", class: "bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>
