<div class="space-y-6">
  <%= render "progress" %>

  <div class="site-shell-surface overflow-hidden">
    <div class="border-b border-white/10 px-6 py-8 sm:px-8">
      <p class="site-kicker">Step 4</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Education</h1>
      <p class="mt-3 text-sm leading-7 text-slate-300 sm:text-base">Add your educational background, certifications, or relevant training that supports the roles you’re applying for.</p>
    </div>

    <div class="px-6 py-8 sm:px-8">
      <section class="site-panel">
        <h3 class="text-lg font-semibold text-slate-900">Education History</h3>

        <% if @resume.educations.any? %>
          <div class="mt-5 space-y-4">
            <% @resume.educations.each do |edu| %>
              <div class="rounded-2xl border border-slate-200 p-4">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h4 class="font-semibold text-slate-900"><%= edu.field_of_study %></h4>
                    <p class="mt-1 text-sm text-slate-500">
                      <%= edu.school %> • <%= edu.location %> • <%= edu.start_date.strftime("%b %Y") %> - <%= edu.end_date&.strftime("%b %Y") || "Present" %>
                    </p>
                  </div>
                  <div class="flex gap-4">
                    <%= link_to "Edit", edit_education_path(edu), class: "site-action-link" %>
                    <%= link_to "Delete", education_path(edu), data: { turbo_method: :delete, confirm: "Are you sure?" }, class: "site-danger-link" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-slate-500">
            <p>No education entries added yet.</p>
          </div>
        <% end %>
      </section>

      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <%= link_to "Add New Education", new_education_path, class: "site-btn-primary" %>
        <div class="flex items-center justify-between gap-6">
          <%= link_to "Previous: Skills", resume_wizard_path(id: :skills), class: "site-action-link" %>
          <%= link_to "Next: Projects", resume_wizard_path(id: :projects), class: "site-btn-secondary" %>
        </div>
      </div>
    </div>
  </div>
</div>
