<div class="mx-4 my-4">
  <%= render "progress" %>
  <h1 class="text-2xl font-bold mb-6 text-center">Step 4: Education</h1>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-4 text-gray-800">Your Education</h2>
      <p class="text-gray-600 mb-6">Add your educational background, including degrees, certifications, and relevant coursework.</p>
    </div>

    <div class="mb-6">
      <h3 class="text-md font-semibold mb-4 text-gray-700">Education History</h3>

      <% if @resume.educations.any? %>
        <% @resume.educations.each do |edu| %>
          <div class="mb-4 p-4 border border-gray-200 rounded-lg bg-gray-50">
            <div class="flex justify-between items-start mb-2">
              <h4 class="font-semibold text-gray-800"><%= edu.field_of_study %></h4>
              <div class="flex space-x-2">
                <%= link_to "Edit", edit_education_path(edu), class: "text-blue-600 hover:text-blue-800 text-sm" %>
                <%= link_to "Delete", education_path(edu), data: { turbo_method: :delete, confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800 text-sm" %>
              </div>
            </div>
            <p class="text-sm text-gray-600">
              <%= edu.school %> • <%= edu.location %> • <%= edu.start_date.strftime("%b %Y") %> - <%= edu.end_date&.strftime("%b %Y") || "Present" %>
            </p>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <p>No education entries added yet.</p>
        </div>
      <% end %>
    </div>

    <div class="mb-8">
      <%= link_to new_education_path, class: "text-white bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700 hover:bg-gradient-to-br focus:ring-4 focus:outline-none focus:ring-blue-300 dark:focus:ring-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 my-2 inline-block" do %>
        Add New Education
      <% end %>
    </div>

    <div class="flex justify-between items-center">
      <%= link_to "Previous: Skills", resume_wizard_path(:skills), class: "text-blue-600 hover:text-blue-800 font-medium" %>
      <%= link_to "Next: Projects", resume_wizard_path(:projects), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200" %>
    </div>
  </div>
</div>
