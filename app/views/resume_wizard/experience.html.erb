<div class="space-y-6">
  <%= render "progress" %>

  <div class="site-shell-surface overflow-hidden">
    <div class="border-b border-white/10 px-6 py-8 sm:px-8">
      <p class="site-kicker">Step 2</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Work Experience</h1>
      <p class="mt-3 text-sm leading-7 text-slate-300 sm:text-base">Add your recent work history and strongest responsibilities. For most roles, three strong entries is usually enough.</p>
    </div>

    <div class="px-6 py-8 sm:px-8">
      <%= form_with model: @resume, url: resume_wizard_path, method: :put do |f| %>
        <div class="space-y-6">
          <section class="site-panel">
            <% if @resume.experiences.any? %>
              <div class="space-y-4">
                <% @resume.experiences.each do |exp| %>
                  <div class="rounded-2xl border border-slate-200 p-4">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h4 class="font-semibold text-slate-900"><%= exp.title %> @ <%= exp.company_name %></h4>
                        <p class="mt-1 text-sm text-slate-500">
                          <%= exp.location %> • <%= exp.start_date.strftime("%b %Y") %> - <%= exp.end_date&.strftime("%b %Y") || "Present" %>
                        </p>
                      </div>
                      <div class="flex gap-4">
                        <%= link_to "Edit", edit_experience_path(exp), class: "site-action-link" %>
                        <%= link_to "Delete", experience_path(exp), data: { turbo_method: :delete, confirm: "Are you sure?" }, class: "site-danger-link" %>
                      </div>
                    </div>
                    <% if exp.responsibilities.any? %>
                      <ul class="mt-4 list-disc space-y-1 pl-5 text-sm leading-7 text-slate-700">
                        <% exp.responsibilities.first(3).each do |responsibility| %>
                          <li><%= responsibility.content %></li>
                        <% end %>
                        <% if exp.responsibilities.count > 3 %>
                          <li class="italic text-slate-500">... and <%= exp.responsibilities.count - 3 %> more</li>
                        <% end %>
                      </ul>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-slate-500">
                <p>No work experience added yet.</p>
              </div>
            <% end %>
          </section>

          <section class="site-panel-muted">
            <h4 class="text-lg font-semibold text-slate-900">Add Your Work Experience</h4>
            <p class="mt-2 text-sm leading-7 text-slate-600">Use the experience form to add your job title, company, dates, and the impact of your work.</p>
            <div class="mt-4">
              <%= link_to "Add New Experience", new_experience_path, class: "site-btn-primary" %>
            </div>
          </section>

          <div class="flex items-center justify-between">
            <%= link_to "Previous: Summary", resume_wizard_path(id: :summary), class: "site-action-link" %>
            <%= f.submit "Next: Skills", class: "site-btn-primary cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
