<div class="mx-4 my-4">
  <%= render "progress" %>
  <h1 class="text-2xl font-bold mb-6 text-center">Step 1: Resume Summary</h1>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-4 text-gray-800">Tell us about yourself</h2>
      <p class="text-gray-600 mb-6">Start with a compelling summary that highlights your key strengths and career objectives.</p>
    </div>

    <%= form_with model: @resume, url: resume_wizard_path, method: :put do |f| %>
      <% if @resume.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
          <h3 class="text-red-800 font-medium mb-2">Please fix the following errors:</h3>
          <ul class="text-red-700 text-sm">
            <% @resume.errors.full_messages.each do |message| %>
              <li>• <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.label :title, "Professional Title", class: "block text-gray-700 font-semibold mb-2" %>
        <%= f.text_field :title, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "e.g., Senior Software Engineer, Marketing Manager, etc." %>
        <p class="text-sm text-gray-500 mt-1">This will appear prominently under your name</p>
      </div>

      <div class="mb-8">
        <%= f.label :summary, "Professional Summary", class: "block text-gray-700 font-semibold mb-2" %>
        <%= f.rich_text_area :summary, class: "w-full border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", rows: 6 %>
        <p class="text-sm text-gray-500 mt-1">Write 2-4 sentences describing your professional background, key skills, and career goals</p>
      </div>

      <div class="flex justify-between items-center">
        <div></div>
        <%= f.submit "Next: Experience", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>
