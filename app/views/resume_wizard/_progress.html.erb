<% wizard_steps = [[:summary, "Summary"], [:experience, "Experience"], [:skills, "Skills"], [:education, "Education"], [:projects, "Projects"]] %>
<div class="site-shell-surface overflow-hidden">
  <div class="border-b border-white/10 px-6 py-5">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="site-kicker">Resume wizard</p>
        <h2 class="mt-2 text-xl font-semibold text-white">Build your resume step by step</h2>
      </div>
      <p class="text-sm text-slate-400">Step <%= wizard_steps.index { |wizard_step, _| wizard_step == step }.to_i + 1 %> of <%= wizard_steps.length %></p>
    </div>
  </div>

  <div class="px-6 py-5">
    <ol class="grid gap-3 sm:grid-cols-5">
      <% wizard_steps.each_with_index do |(wizard_step, label), index| %>
        <% completed = steps.index(step) > steps.index(wizard_step) %>
        <% active = step == wizard_step %>
        <li class="rounded-2xl border px-4 py-3 <%= active ? 'border-cyan-400/30 bg-cyan-400/10 text-white' : (completed ? 'border-emerald-400/20 bg-emerald-400/10 text-emerald-100' : 'border-white/10 bg-white/5 text-slate-400') %>">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border text-xs font-semibold <%= active ? 'border-cyan-300 bg-cyan-300 text-slate-950' : (completed ? 'border-emerald-300 bg-emerald-300 text-slate-950' : 'border-white/15 text-slate-300') %>">
              <% if completed %>
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
              <% else %>
                <%= index + 1 %>
              <% end %>
            </span>
            <span class="text-sm font-semibold"><%= label %></span>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</div>
