<div class="mx-4 my-4">
  <%= render "progress" %>
  <h1 class="text-2xl font-bold mb-6 text-center">Step 3: Skills</h1>

  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h2 class="text-lg font-semibold mb-4 text-gray-800">Your Skills & Expertise</h2>
      <p class="text-gray-600 mb-6">List your technical skills, soft skills, and areas of expertise.</p>
    </div>

    <%= form_with model: @resume, url: resume_wizard_path, method: :put do |f| %>
      <% if @resume.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
          <h3 class="text-red-800 font-medium mb-2">Please fix the following errors:</h3>
          <ul class="text-red-700 text-sm">
            <% @resume.errors.full_messages.each do |message| %>
              <li>• <%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.label :skills_title, "Skills Section Title", class: "block text-gray-700 font-semibold mb-2" %>
        <%= f.text_field :skills_title, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "e.g., Technical Skills, Core Competencies, or leave blank for 'Skills'" %>
        <p class="text-sm text-gray-500 mt-1">Customize the title for your skills section</p>
      </div>

      <div class="mb-8" data-controller="responsibility" data-responsibility-scope="skills">
        <h3 class="text-md font-semibold mb-4 text-gray-700">Your Skills</h3>

        <% if @resume.skills.any? %>
          <div class="mb-4">
            <p class="text-sm text-gray-600 mb-3">Current skills: <span class="font-medium"><%= @resume.skills.pluck(:name).join(', ') %></span></p>
          </div>
        <% end %>

        <div data-responsibility-target="container">
          <%= f.fields_for :skills do |skill_form| %>
            <div class="nested-fields mb-3 flex items-center space-x-2" data-new-record="false">
              <%= skill_form.text_field :name, class: "flex-1 p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Enter skill name" %>
              <button type="button" class="text-red-500 hover:text-red-700 font-bold text-lg" data-action="click->responsibility#remove">&times;</button>
              <%= skill_form.hidden_field :_destroy, value: 0 %>
            </div>
          <% end %>
        </div>

        <template data-responsibility-target="template">
          <div class="nested-fields mb-3 flex items-center space-x-2" data-new-record="true">
            <input type="text" name="resume[skills_attributes][NEW_RECORD][name]" class="flex-1 p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Enter skill name">
            <button type="button" class="text-red-500 hover:text-red-700 font-bold text-lg" data-action="click->responsibility#remove">&times;</button>
            <input type="hidden" name="resume[skills_attributes][NEW_RECORD][_destroy]" value="0">
          </div>
        </template>

        <button type="button" class="text-blue-600 hover:text-blue-800 font-medium" data-action="click->responsibility#add">
          + Add Another Skill
        </button>
      </div>

      <div class="flex justify-between items-center">
        <%= link_to "Previous: Experience", resume_wizard_path(:experience), class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <%= f.submit "Next: Education", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>
