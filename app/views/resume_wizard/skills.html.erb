<div class="space-y-6">
  <%= render "progress" %>

  <div class="site-shell-surface overflow-hidden">
    <div class="border-b border-white/10 px-6 py-8 sm:px-8">
      <p class="site-kicker">Step 3</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Skills</h1>
      <p class="mt-3 text-sm leading-7 text-slate-300 sm:text-base">List the technical skills, tools, and strengths that support the roles you are targeting.</p>
    </div>

    <div class="px-6 py-8 sm:px-8">
      <%= form_with model: @resume, url: resume_wizard_path, method: :put do |f| %>
        <% if @resume.errors.any? %>
          <div class="mb-6 rounded-[1.5rem] border border-rose-200 bg-rose-50 p-4">
            <h3 class="font-medium text-rose-800">Please fix the following errors:</h3>
            <ul class="mt-2 text-sm text-rose-700">
              <% @resume.errors.full_messages.each do |message| %>
                <li>• <%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-6">
          <section class="site-panel">
            <%= f.label :skills_title, "Skills Section Title", class: "mb-2 block text-sm font-semibold text-slate-700" %>
            <%= f.text_field :skills_title, class: "site-input", placeholder: "e.g., Technical Skills, Core Competencies, or leave blank for 'Skills'" %>
            <p class="mt-2 text-sm text-slate-500">Customize the heading for this section if you want something more specific than “Skills”.</p>
          </section>

          <section class="site-panel" data-controller="responsibility" data-responsibility-scope="skills">
            <h3 class="text-lg font-semibold text-slate-900">Your Skills</h3>

            <% if @resume.skills.any? %>
              <p class="mt-2 text-sm text-slate-500">Current skills: <span class="font-medium text-slate-700"><%= @resume.skills.pluck(:name).join(', ') %></span></p>
            <% end %>

            <div class="mt-5" data-responsibility-target="container">
              <%= f.fields_for :skills do |skill_form| %>
                <div class="nested-fields mb-3 flex items-center space-x-2 rounded-2xl border border-slate-200 p-3" data-new-record="false">
                  <%= skill_form.text_field :name, class: "site-input", placeholder: "Enter skill name" %>
                  <button type="button" class="px-2 pt-1 text-xl text-rose-500 hover:text-rose-700" data-action="click->responsibility#remove">&times;</button>
                  <%= skill_form.hidden_field :_destroy, value: 0 %>
                </div>
              <% end %>
            </div>

            <template data-responsibility-target="template">
              <div class="nested-fields mb-3 flex items-center space-x-2 rounded-2xl border border-slate-200 p-3" data-new-record="true">
                <input type="text" name="resume[skills_attributes][NEW_RECORD][name]" class="site-input" placeholder="Enter skill name">
                <button type="button" class="px-2 pt-1 text-xl text-rose-500 hover:text-rose-700" data-action="click->responsibility#remove">&times;</button>
                <input type="hidden" name="resume[skills_attributes][NEW_RECORD][_destroy]" value="0">
              </div>
            </template>

            <button type="button" class="site-btn-secondary mt-3 cursor-pointer" data-action="click->responsibility#add">
              Add Another Skill
            </button>
          </section>

          <div class="flex items-center justify-between">
            <%= link_to "Previous: Experience", resume_wizard_path(id: :experience), class: "site-action-link" %>
            <%= f.submit "Next: Education", class: "site-btn-primary cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
