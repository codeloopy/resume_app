<div class="mx-4 my-4">
  <div class="max-w-4xl mx-auto text-center">
    <div class="mb-8">
      <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
        <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Resume Complete!</h1>
      <p class="text-lg text-gray-600 mb-8">Your resume has been successfully created and is ready to use.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">View Your Resume</h3>
        <p class="text-gray-600 mb-4">See how your resume looks and share it with others.</p>
        <%= link_to "View Resume", resume_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-200" %>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Download PDF</h3>
        <p class="text-gray-600 mb-4">Download your resume as a professional PDF file.</p>
        <%= link_to "Download PDF", public_resume_pdf_download_path(@resume.slug), class: "inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition duration-200" %>
      </div>
    </div>

    <div class="bg-gray-50 p-6 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-800 mb-3">What's Next?</h3>
      <div class="grid md:grid-cols-3 gap-4 text-sm text-gray-600">
        <div>
          <p class="font-medium text-gray-800">✓ Resume Created</p>
          <p>Your professional resume is ready</p>
        </div>
        <div>
          <p class="font-medium text-gray-800">✓ PDF Available</p>
          <p>Download and share your resume</p>
        </div>
        <div>
          <p class="font-medium text-gray-800">✓ Always Editable</p>
          <p>Update your resume anytime</p>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <%= link_to "Edit Resume", edit_resume_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
      <span class="mx-2 text-gray-400">|</span>
      <%= link_to "Start Over", resume_wizard_path(:summary), class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </div>
  </div>
</div>
