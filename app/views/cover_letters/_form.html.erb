<%= form_with model: [ resume, cover_letter ], local: true do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :title, "Title (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded-md p-2", placeholder: "e.g. Acme Inc - Software Engineer" %>
    </div>
    <div>
      <%= f.label :company_name, "Company Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :company_name, class: "w-full border border-gray-300 rounded-md p-2" %>
    </div>
    <div>
      <%= f.label :job_title, "Job Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :job_title, class: "w-full border border-gray-300 rounded-md p-2" %>
    </div>
    <div>
      <%= f.label :job_description, "Job Description (for reference)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :job_description, rows: 4, class: "w-full border border-gray-300 rounded-md p-2", placeholder: "Optional: paste job description for your reference" %>
    </div>
    <div>
      <%= f.label :content, "Cover Letter Content", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.rich_text_area :content, class: "w-full border border-gray-300 rounded-md min-h-[300px]" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit class: "bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-6 rounded-lg transition cursor-pointer" %>
      <%= link_to "Cancel", cover_letter.persisted? ? resume_cover_letter_path(resume, cover_letter) : resume_cover_letters_path(resume), class: "text-gray-600 hover:text-gray-900 font-medium py-2" %>
    </div>
  </div>
<% end %>
