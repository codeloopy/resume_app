<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6 flex justify-between items-center">
    <%= link_to "← Back to Cover Letters", resume_cover_letters_path(@resume), class: "text-gray-600 hover:text-gray-900 font-medium text-sm" %>
    <%= link_to "Download PDF", pdf_resume_cover_letter_path(@resume, @cover_letter), class: "text-blue-600 hover:text-blue-800 font-medium text-sm", target: "_blank" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-8">Edit Cover Letter</h1>

  <%= render "form", cover_letter: @cover_letter, resume: @resume %>
</div>
