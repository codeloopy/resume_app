<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Cover Letters", resume_cover_letters_path(@resume), class: "text-gray-600 hover:text-gray-900 font-medium text-sm" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-8">New Cover Letter</h1>

  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8">
    <h3 class="font-semibold text-blue-900 mb-2">Generate from job description</h3>
    <p class="text-sm text-blue-800 mb-4">Paste the job description below and we'll create a tailored cover letter based on your resume.</p>

    <%= form_with url: generate_resume_cover_letters_path(@resume), method: :post, local: true do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :company_name, "Company Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :company_name, name: "cover_letter[company_name]", class: "w-full border border-gray-300 rounded-md p-2", placeholder: "Acme Inc." %>
        </div>
        <div>
          <%= f.label :job_title, "Job Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :job_title, name: "cover_letter[job_title]", class: "w-full border border-gray-300 rounded-md p-2", placeholder: "Senior Software Engineer" %>
        </div>
        <div>
          <%= f.label :job_description, "Job Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :job_description, name: "cover_letter[job_description]", rows: 8, class: "w-full border border-gray-300 rounded-md p-2", placeholder: "Paste the full job description here..." %>
        </div>
        <%= f.submit "Generate Cover Letter", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="border-t border-gray-200 pt-8">
    <h3 class="font-semibold text-gray-900 mb-4">Or start from scratch</h3>
    <%= render "form", cover_letter: @cover_letter, resume: @resume %>
  </div>
</div>
