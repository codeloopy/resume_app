<div class="mb-4 mt-4 space-y-2">
  <% if current_user %>
    <% if current_user.guest? %>
      <!-- <div class="inline-block px-4 py-2 bg-gradient-to-r from-orange-500 via-orange-600 to-orange-700 text-white font-semibold rounded text-xs mr-2">
        <span class="flex items-center">
          <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
          </svg>
          PDF Download Locked
        </span>
      </div> -->

      <%= link_to "Complete Account to Download Resume",
                  upgrade_guest_user_form_path,
                  class: "inline-block px-4 py-2 bg-gradient-to-r from-green-600 via-green-700 to-green-800 hover:bg-gradient-to-br text-white font-semibold rounded text-xs" %>
    <% else %>
      <%= link_to "Preview PDF",
                  public_resume_pdf_path(@resume.slug),
                  class: "inline-block px-4 py-2 bg-gradient-to-r from-green-500 via-green-600 to-green-700 hover:bg-gradient-to-br text-white font-semibold rounded hover:gradient-to-b text-xs mr-2",
                  target: "_blank", rel: "noopener",
                  data: {
                    controller: "pdf-tracking",
                    action: "click->pdf-tracking#trackEvent",
                    pdf_tracking_action_value: "view_pdf",
                    pdf_tracking_slug_value: @resume.slug
                  } %>

      <%= link_to "Download PDF",
                  public_resume_pdf_download_path(@resume.slug),
                  class: "inline-block px-4 py-2 bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700 hover:bg-gradient-to-br text-white font-semibold rounded hover:gradient-to-b text-xs cursor-pointer",
                  target: "_blank" %>
      <%= render "view_public_resume_link" %>
    <% end %>
  <% end %>
</div>
