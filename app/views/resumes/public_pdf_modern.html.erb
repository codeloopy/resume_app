<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= resume.user.first_name %> <%= resume.user.last_name %> - Resume</title>
    <style>
      @media print {
        body {
          print-color-adjust: exact;
        }
      }
      body {
        font-size: 10px;
        line-height: 1.3;
        color: #333;
        margin: 0;
        padding: 12px;
        background-color: white;
      }

      /* Container */
      .max-w-4xl {
        max-width: 800px;
        margin: 0 auto;
      }

      .mx-auto {
        margin-left: auto;
        margin-right: auto;
      }

      .bg-white {
        background-color: white;
      }

      .p-4 {
        padding: 16px;
      }

      /* Typography */
      .text-left {
        text-align: left;
      }

      .text-3xl {
        font-size: 20px;
      }

      .text-lg {
        font-size: 12px;
      }

      .text-sm {
        font-size: 9.5px;
      }

      .font-bold {
        font-weight: bold;
      }

      .font-semibold {
        font-weight: 600;
      }

      .tracking-wide {
        letter-spacing: 0.025em;
      }

      .leading-relaxed {
        line-height: 1.4;
      }

      .text-justify {
        text-align: justify;
      }

      /* Colors */
      .text-gray-700 {
        color: #374151;
      }

      .text-gray-600 {
        color: #4b5563;
      }

      .text-gray-900 {
        color: #111827;
      }

      /* Spacing */
      .mb-2 {
        margin-bottom: 6px;
      }

      .mb-3 {
        margin-bottom: 8px;
      }

      .mb-4 {
        margin-bottom: 10px;
      }

      .mb-6 {
        margin-bottom: 12px;
      }

      .mb-8 {
        margin-bottom: 18px;
      }

      .ml-4 {
        margin-left: 16px;
      }

      .mr-2 {
        margin-right: 8px;
      }

      /* Layout */
      .flex {
        display: flex;
      }

      .justify-between {
        justify-content: space-between;
      }

      .items-start {
        align-items: flex-start;
      }

      .space-y-1 > * + * {
        margin-top: 4px;
      }

      .space-y-2 > * + * {
        margin-top: 8px;
      }

      /* Lists */
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li {
        margin-bottom: 2px;
        page-break-inside: avoid;
      }

      .mt-4 {
        margin-top: 12px;
      }

      .mt-6 {
        margin-top: 14px;
      }

      /* Header styles */
      header {
        padding-bottom: 8px;
      }

      h1 {
        margin: 0 0 2px 0;
        color: #111827;
      }

      h2 {
        margin: 0 0 6px 0;
        color: #111827;
        padding-bottom: 3px;
        font-size: 11px;
      }

      h3 {
        margin: 0 0 2px 0;
        color: #111827;
        font-size: 10px;
      }

      p {
        margin: 0 0 4px 0;
      }

      /* Sections */
      section {
        margin-bottom: 12px;
      }

      /* Experience items */
      .experience-item {
        margin-bottom: 10px;
      }

      .experience-item h3 {
        margin-bottom: 2px;
      }

      .experience-item p {
        margin-bottom: 4px;
      }

      /* Project items */
      .project-item {
        margin-bottom: 10px;
      }

      .project-item h3 {
        margin-bottom: 2px;
      }

      .project-item p {
        margin-bottom: 4px;
      }

      .education-item {
        margin-bottom: 10px;
      }

      .education-item h3 {
        margin-bottom: 2px;
      }

      .education-item p {
        margin-bottom: 4px;
      }

      /* Prose / summary */
      .prose {
        line-height: 1.35;
        margin-bottom: 12px;
      }

      .prose p {
        margin-bottom: 4px;
      }

      .skills-list {
        margin-bottom: 12px;
      }

      li {
        margin-bottom: 2px;
      }
      .uppercase {
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <div class="max-w-4xl mx-auto bg-white">
      <header class="text-left mb-8">
        <h1 class="text-3xl font-bold tracking-wide"><%= user_full_name(resume) %></h1>
        <span class="text-lg font-semibold uppercase"><%= resume.title %></span>
        <div class="text-sm text-gray-700">
          <% if resume.user.location.present? %>
            <%= resume.user.location %>
          <% end %>
          <% if resume.user.phone.present? %>
            <% if resume.user.location.present? %> | <% end %>
            <%= styled_telephone_number(resume.user.phone) %>
          <% end %>
          <% if resume.user.email.present? %>
            <% if resume.user.phone.present? || resume.user.location.present? %> | <% end %>
            <%= resume.user.email %>
          <% end %>
          <% if resume.user.linked_in_url.present? %>
            <% if resume.user.phone.present? || resume.user.email.present? || resume.user.location.present? %> | <% end %>
            /in/<%= resume.user.linked_in_url.split("/").last %>
          <% end %>
          <% if resume.user.github_url.present? %>
            <% if resume.user.phone.present? || resume.user.email.present? || resume.user.linked_in_url.present? || resume.user.location.present? %> | <% end %>
            <%= resume.user.github_url.split('//').last %>
          <% end %>
        </div>
      </header>

      <%# Summary %>
      <% if resume.summary&.body&.present? %>
        <h2 class="text-xl font-semibold mt-5 mb-2 text-gray-700 uppercase">Summary</h2>
        <div class="prose">
          <%= resume.summary.body.to_s.html_safe %>
        </div>
      <% end %>

      <%# Skills %>
      <% if resume.skills.any? %>
        <h2 class="text-xl font-semibold mt-5 mb-2 text-gray-700 uppercase"><%= skills_title(resume) %></h2>
        <div class="skills-list">
          <% resume.skills.each do |skill| %>
            <span class="text-xs inline-block"><%= skill.name %><%= skill == resume.skills.last ? "." : ", " %></span>
          <% end %>
        </div>
      <% end %>

      <%# Experiences %>
      <% if resume.experiences.any? %>
        <h2 class="text-xl font-semibold mt-5 mb-2 text-gray-700 uppercase">Experience</h2>
        <% resume.experiences.each do |exp| %>
          <div class="experience-item">
            <h3 class="font-bold"><%= exp.title %> @ <%= exp.company_name %></h3>
            <p class="text-sm text-gray-500 mb-2">
              <%= exp.location %> · <%= exp.start_date&.strftime("%b %Y") %> – <%= exp.end_date&.strftime("%b %Y") || "Present" %>
            </p>
            <% if exp.responsibilities.any? %>
              <ul class="list-disc list-outside ml-5">
                <% exp.responsibilities.each do |b| %>
                  <li><%= b.content %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <%# Education %>
      <% if resume.educations.any? %>
        <h2 class="text-xl font-semibold mt-5 mb-2 text-gray-700 uppercase">Education</h2>
        <% resume.educations.each do |edu| %>
          <div class="education-item">
            <h3 class="font-bold"><%= edu.school %></h3>
            <p class="text-sm text-gray-500">
              <%= edu.field_of_study %> · <%= edu.start_date&.year %> – <%= edu.end_date&.year || "Present" %>
            </p>
          </div>
        <% end %>
      <% end %>

      <%# Projects %>
      <% if resume.projects.any? %>
        <h2 class="text-xl font-semibold mt-5 mb-2 text-gray-700 uppercase">Projects</h2>
        <% resume.projects.each do |proj| %>
          <div class="project-item">
            <h3 class="font-bold"><%= proj.title %></h3>
            <% if proj.url.present? %>
              <p class="text-sm text-gray-500">
                <a href="<%= proj.url %>" class="text-blue-500 underline"><%= proj.url %></a>
              </p>
            <% end %>
            <% if proj.description&.body&.present? %>
              <div class="prose">
                <%= proj.description.body.to_s.html_safe %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </body>
</html>
