<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= resume.user.first_name %> <%= resume.user.last_name %> - Resume</title>
    <style>
      @media print { body { print-color-adjust: exact; } }
      body { font-family: "Times New Roman", Times, serif; font-size: 11px; line-height: 1.4; color: #1f2937; margin: 0; padding: 24px; background: white; }
      .container { max-width: 750px; margin: 0 auto; }
      header { text-align: center; border-bottom: 2px solid #1f2937; padding-bottom: 16px; margin-bottom: 24px; }
      h1 { font-size: 20px; font-weight: 700; letter-spacing: 0.05em; margin: 0 0 4px 0; color: #1f2937; }
      .title { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #4b5563; }
      .contact { font-size: 10px; color: #6b7280; margin-top: 8px; }
      h2 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: #1f2937; margin: 20px 0 10px 0; padding-bottom: 4px; border-bottom: 1px solid #1f2937; }
      .experience-item, .education-item, .project-item { margin-bottom: 16px; }
      .experience-item h3, .education-item h3, .project-item h3 { font-size: 11px; font-weight: 700; margin: 0 0 2px 0; text-transform: uppercase; }
      .meta { font-size: 10px; color: #6b7280; margin-bottom: 4px; }
      ul { margin: 0; padding: 0 0 0 16px; }
      li { margin-bottom: 3px; font-size: 11px; }
      .skills-list { font-size: 11px; color: #4b5563; }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1><%= user_full_name(resume) %></h1>
        <div class="title"><%= resume.title %></div>
        <div class="contact">
          <% parts = [] %>
          <% parts << resume.user.location if resume.user.location.present? %>
          <% parts << styled_telephone_number(resume.user.phone) if resume.user.phone.present? %>
          <% parts << resume.user.email if resume.user.email.present? %>
          <% parts << "LinkedIn: /in/#{resume.user.linked_in_url.split('/').last}" if resume.user.linked_in_url.present? %>
          <% parts << resume.user.github_url.split('//').last if resume.user.github_url.present? %>
          <%= parts.join(" | ") %>
        </div>
      </header>

      <% if resume.summary&.body&.present? %>
        <h2>Executive Summary</h2>
        <div><%= resume.summary.body.to_s.html_safe %></div>
      <% end %>

      <% if resume.skills.any? %>
        <h2><%= skills_title(resume) %></h2>
        <div class="skills-list"><% resume.skills.each do |skill| %><%= skill.name %><%= skill == resume.skills.last ? "" : " | " %><% end %></div>
      <% end %>

      <% if resume.experiences.any? %>
        <h2>Professional Experience</h2>
        <% resume.experiences.each do |exp| %>
          <div class="experience-item">
            <h3><%= exp.company_name %>, <%= exp.location %></h3>
            <div class="meta"><%= exp.title %> · <%= exp.start_date&.strftime("%Y") %> – <%= exp.end_date&.strftime("%Y") || "Present" %></div>
            <% if exp.responsibilities.any? %><ul><% exp.responsibilities.each do |b| %><li><%= b.content %></li><% end %></ul><% end %>
          </div>
        <% end %>
      <% end %>

      <% if resume.educations.any? %>
        <h2>Education</h2>
        <% resume.educations.each do |edu| %>
          <div class="education-item">
            <h3><%= edu.school %></h3>
            <div class="meta"><%= edu.field_of_study %> · <%= edu.start_date&.year %> – <%= edu.end_date&.year || "Present" %></div>
          </div>
        <% end %>
      <% end %>

      <% if resume.projects.any? %>
        <h2>Key Projects</h2>
        <% resume.projects.each do |proj| %>
          <div class="project-item">
            <h3><%= proj.title %></h3>
            <% if proj.url.present? %><div class="meta"><%= proj.url %></div><% end %>
            <% if proj.description&.body&.present? %><div><%= proj.description.body.to_s.html_safe %></div><% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </body>
</html>
