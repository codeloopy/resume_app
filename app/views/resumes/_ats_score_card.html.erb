<% analysis = resume.ats_analysis %>
<% presenter = AtsAnalysisPresenter.new(analysis, user: current_user) %>
<% score = presenter.score %>
<% grade = presenter.grade %>
<% suggestions = presenter.suggestions %>

<% score_color = case score
  when 90..100 then "bg-green-100 text-green-800 border-green-300"
  when 70..89 then "bg-blue-100 text-blue-800 border-blue-300"
  when 50..69 then "bg-yellow-100 text-yellow-800 border-yellow-300"
  else "bg-red-100 text-red-800 border-red-300"
end %>

<div class="border-2 rounded-lg p-4 mb-6 shadow-sm <%= score_color %>" role="region" aria-label="ATS Score">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div class="flex items-center gap-3">
      <div class="text-3xl font-bold"><%= score %></div>
      <div>
        <div class="font-semibold text-base">ATS Score</div>
        <div class="text-sm opacity-90">Grade: <%= grade %> — How well your resume parses in applicant tracking systems</div>
      </div>
    </div>
    <%= link_to "View Full Analysis", analyze_resume_path, class: "text-sm font-medium underline hover:no-underline" %>
  </div>
  <% if suggestions.any? %>
    <div class="mt-4 pt-4 border-t border-current/20">
      <div class="text-sm font-semibold mb-2">Top suggestions:</div>
      <ul class="text-sm space-y-1 list-disc list-inside">
        <% suggestions.first(3).each do |suggestion| %>
          <li><%= suggestion %></li>
        <% end %>
      </ul>
      <% if presenter.locked? && analysis[:suggestions].size > 3 %>
        <p class="text-xs mt-2 opacity-80">
          <%= link_to "Upgrade for more suggestions", pricing_path, class: "underline hover:no-underline" %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
