<% analysis = resume.ats_analysis %>
<% viewer = local_assigns[:user] || resume.user %>
<% if viewer %>
<% presenter = AtsAnalysisPresenter.new(analysis, user: viewer) %>
<% score = presenter.score %>
<% grade = presenter.grade %>
<% suggestions = presenter.suggestions %>
<% total_suggestions = analysis[:suggestions] || [] %>

<% score_color = case score
  when 90..100 then "ats-score-card--emerald"
  when 70..89 then "ats-score-card--cyan"
  when 50..69 then "ats-score-card--amber"
  else "ats-score-card--rose"
end %>

<div class="ats-score-card <%= score_color %> rounded-[1.75rem] border p-5 shadow-xl shadow-slate-950/20" role="region" aria-label="ATS Score">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div class="flex items-center gap-3">
      <div class="text-4xl font-semibold"><%= score %></div>
      <div>
        <div class="font-semibold text-base">ATS Score</div>
        <div class="text-sm opacity-90">Grade: <%= grade %> — How well your resume parses in applicant tracking systems</div>
      </div>
    </div>
    <%= link_to "View Full Analysis", analyze_resume_path, class: "ats-score-card__action rounded-xl border border-current/20 px-4 py-2 text-sm font-semibold transition" %>
  </div>
  <% if suggestions.any? %>
    <div class="mt-4 pt-4 border-t border-current/20">
      <div class="text-sm font-semibold mb-2">Top suggestions:</div>
      <ul class="text-sm space-y-1 list-disc list-inside">
        <% suggestions.first(3).each do |suggestion| %>
          <li><%= suggestion %></li>
        <% end %>
      </ul>
      <% if presenter.locked? && total_suggestions.size > AtsAnalysisPresenter::FREE_SUGGESTION_LIMIT %>
        <p class="text-xs mt-2 opacity-80">
          <%= link_to "Upgrade for more suggestions", pricing_path, class: "underline hover:no-underline" %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
<% end %>
