<%= render "resumes/public_meta_tags" %>

<div class="mx-auto max-w-5xl space-y-6 py-8">
  <div class="rounded-[2rem] border border-slate-200 bg-white px-6 py-10 shadow-2xl shadow-slate-300/20 sm:px-10 lg:px-14">
    <header class="border-b border-slate-200 pb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-700">Public Resume</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-900">
        <%= user_full_name(@resume) %>
      </h1>
      <% if @resume.title.present? %>
        <p class="mt-2 text-lg text-slate-500"><%= @resume.title %></p>
      <% end %>

      <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm text-slate-600">
        <% if @resume.user.location.present? %>
          <span class="site-chip"><%= @resume.user.location %></span>
        <% end %>
        <% if @resume.user.email.present? %>
          <a href="mailto:<%= @resume.user.email %>" class="site-chip transition hover:border-cyan-300 hover:text-cyan-700">Email</a>
        <% end %>
        <% if @resume.user.phone.present? %>
          <a href="tel:+<%= @resume.user.phone %>" class="site-chip transition hover:border-cyan-300 hover:text-cyan-700"><%= styled_telephone_number(@resume.user.phone) %></a>
        <% end %>
        <% if @resume.user.linked_in_url.present? %>
          <a href="<%= @resume.user.linked_in_url %>" class="site-chip transition hover:border-cyan-300 hover:text-cyan-700">LinkedIn</a>
        <% end %>
        <% if @resume.user.github_url.present? %>
          <a href="<%= @resume.user.github_url %>" class="site-chip transition hover:border-cyan-300 hover:text-cyan-700">GitHub</a>
        <% end %>
        <% if @resume.user.portfolio.present? %>
          <a href="<%= @resume.user.portfolio %>" class="site-chip transition hover:border-cyan-300 hover:text-cyan-700">Portfolio</a>
        <% end %>
      </div>
    </header>

    <div class="space-y-8 pt-8">
      <% if @resume.summary.present? %>
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Summary</h2>
          <div class="trix-content mt-4 text-[15px] leading-7 text-slate-700">
            <%= @resume.summary %>
          </div>
        </section>
      <% end %>

      <% if @resume.skills.present? %>
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500"><%= skills_title(@resume) %></h2>
          <div class="mt-4 flex flex-wrap gap-2">
            <% @resume.skills.each do |skill| %>
              <span class="site-chip"><%= skill.name %></span>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @resume.experiences.present? %>
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Experience</h2>
          <div class="mt-4 space-y-6">
            <% @resume.experiences.each do |exp| %>
              <article class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h3 class="text-lg font-semibold text-slate-900"><%= exp.title %> @ <%= exp.company_name %></h3>
                    <p class="text-sm text-slate-500">
                      <%= exp.location %> · <%= exp.start_date&.strftime("%b %Y") %> – <%= exp.end_date&.strftime("%b %Y") || "Present" %>
                    </p>
                  </div>
                </div>

                <% if exp.responsibilities.any? %>
                  <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-7 text-slate-700">
                    <% exp.responsibilities.each do |b| %>
                      <li><%= b.content %></li>
                    <% end %>
                  </ul>
                <% end %>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @resume.educations.present? %>
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Education</h2>
          <div class="mt-4 space-y-4">
            <% @resume.educations.each do |edu| %>
              <article class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                <h3 class="text-lg font-semibold text-slate-900"><%= edu.school %></h3>
                <p class="mt-1 text-[15px] text-slate-600">
                  <%= edu.field_of_study %> · <%= edu.start_date&.year %> – <%= edu.end_date&.year || "Present" %>
                </p>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @resume.projects.present? %>
        <section>
          <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Projects</h2>
          <div class="mt-4 space-y-4">
            <% @resume.projects.each do |proj| %>
              <article class="rounded-[1.5rem] border border-slate-200 bg-slate-50 px-5 py-4">
                <h3 class="text-lg font-semibold text-slate-900"><%= proj.title %></h3>
                <% if proj.url.present? %>
                  <p class="mt-2">
                    <a href="<%= proj.url %>" class="site-inline-link" target="_blank" rel="noopener"><%= proj.url %></a>
                  </p>
                <% end %>
                <div class="trix-content mt-3 text-[15px] leading-7 text-slate-700">
                  <%= proj.description %>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>

  <% if current_user && current_user.id == @resume.user_id %>
    <div class="site-panel">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="site-kicker-light">Owner Actions</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">Manage this public version</h2>
          <p class="mt-2 text-sm leading-7 text-slate-600">Preview the PDF, download a copy, or jump back into editing before you share it.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <% if current_user.guest? %>
            <%= link_to "Complete Account to Download Resume", upgrade_guest_user_form_path, class: "site-btn-primary text-sm" %>
          <% elsif resume_completed(@resume) %>
            <%= link_to "Preview PDF",
                        public_resume_pdf_path(@resume.slug),
                        class: "site-btn-primary text-sm",
                        target: "_blank", rel: "noopener",
                        data: {
                          controller: "pdf-tracking",
                          action: "click->pdf-tracking#trackEvent",
                          pdf_tracking_action_value: "view_pdf",
                          pdf_tracking_slug_value: @resume.slug
                        } %>

            <%= link_to "Download PDF",
                        public_resume_pdf_download_path(@resume.slug),
                        class: "site-btn-dark text-sm cursor-pointer",
                        target: "_blank" %>
          <% end %>

          <%= link_to "Edit Resume", edit_resume_path, class: "site-btn-secondary text-sm" %>

          <% if resume_completed(@resume) %>
            <button
              class="site-btn-dark text-sm cursor-pointer"
              data-controller="clipboard"
              data-clipboard-text-value="<%= public_resume_url(@resume.slug) %>"
              data-action="click->clipboard#copy"
              title="<%= public_resume_url(@resume.slug) %>"
            >
              Copy Public Link
            </button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
