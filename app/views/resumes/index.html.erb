<div class="site-shell-surface overflow-hidden">
  <div class="border-b border-white/10 px-6 py-8 sm:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="site-kicker">Resume workspace</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-white sm:text-4xl">My Resumes</h1>
        <p class="mt-3 text-sm leading-7 text-slate-300 sm:text-base">
          Manage your active resume versions, switch contexts quickly, and keep your core application materials organized in one place.
        </p>
      </div>

      <% if @resumes.any? && current_user.premium? && !current_user.at_resume_limit? %>
        <%= button_to "New Resume", resumes_path, method: :post, class: "site-btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="px-6 py-8 sm:px-8">
    <% if @resumes.empty? %>
      <div class="site-panel-muted border-dashed text-center">
        <p class="text-lg font-semibold text-slate-900">You do not have any resumes yet.</p>
        <p class="mt-2 text-sm leading-7 text-slate-600">Start your first resume and build the foundation for the rest of your application workflow.</p>
        <div class="mt-6">
          <%= button_to "Start Resume", resumes_path, method: :post, class: "site-btn-primary" %>
        </div>
      </div>
    <% else %>
      <div class="mb-6 rounded-[1.5rem] border border-white/10 bg-white/5 px-5 py-4 text-sm text-slate-300">
        You have <span class="font-semibold text-white"><%= current_user.resume_count %></span> of
        <span class="font-semibold text-white"><%= current_user.resume_limit %></span>
        resume<%= current_user.resume_limit == 1 ? '' : 's' %>.
        <% if current_user.free? %>
          <%= link_to "Upgrade to Growth or Pro", pricing_path, class: "ml-1 font-medium text-cyan-200 underline decoration-cyan-300/50 underline-offset-4 transition hover:text-white" %>
          for multiple resumes.
        <% end %>
      </div>

      <div class="space-y-4">
        <% @resumes.each do |resume| %>
          <% ats = resume.ats_analysis %>
          <% score_color = ats[:score] >= 70 ? "bg-emerald-50 text-emerald-700" : (ats[:score] >= 50 ? "bg-amber-50 text-amber-700" : "bg-rose-50 text-rose-700") %>
          <div class="site-app-card">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="truncate text-xl font-semibold text-slate-900">
                    <%= link_to (resume.title.presence || "Untitled Resume"), public_resume_path(resume.slug), class: "transition hover:text-cyan-700" %>
                  </h2>
                  <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold <%= score_color %>">ATS <%= ats[:score] %></span>
                  <% if resume.id == current_user.current_resume_id %>
                    <span class="site-chip">Current resume</span>
                  <% end %>
                </div>
                <p class="mt-2 text-sm text-slate-500">Updated <%= time_ago_in_words(resume.updated_at) %> ago</p>
              </div>

              <div class="flex flex-wrap items-center gap-4 text-sm">
                <% if resume.id != current_user.current_resume_id %>
                  <%= button_to "Edit", switch_resume_path(resume), method: :post, class: "site-action-link" %>
                <% else %>
                  <%= link_to "Edit", edit_resume_path, class: "site-action-link" %>
                <% end %>

                <% if current_user.cover_letter_access? %>
                  <%= link_to "Cover Letters", resume_cover_letters_path(resume), class: "site-action-link" %>
                <% else %>
                  <%= link_to "Cover Letters", pricing_path, class: "text-sm font-medium text-slate-400 transition hover:text-slate-600", title: "Growth & Pro feature" %>
                <% end %>

                <% if current_user.job_application_access? %>
                  <%= link_to "Job Tracker", resume_job_applications_path(resume), class: "site-action-link" %>
                <% else %>
                  <%= link_to "Job Tracker", pricing_path, class: "text-sm font-medium text-slate-400 transition hover:text-slate-600", title: "Pro feature" %>
                <% end %>

                <%= link_to "View", public_resume_path(resume.slug), class: "text-sm font-medium text-slate-500 transition hover:text-slate-700 hover:underline" %>

                <% if current_user.pro? %>
                  <%= link_to "Analytics", analytics_for_resume_path(resume.slug), class: "site-action-link" %>
                <% end %>

                <%= button_to "Delete", "/resumes/#{resume.slug}", method: :delete, form: { data: { turbo_confirm: "Delete this resume?" } }, class: "site-danger-link" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
