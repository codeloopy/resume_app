<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold text-gray-900">ATS Resume Analysis</h1>
    <%= link_to "Back to Edit", edit_resume_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
  </div>

  <% analysis = @ats_analysis %>
  <% score = analysis[:score] %>
  <% grade = analysis[:grade] %>

  <% score_color = case score
    when 90..100 then "bg-green-500"
    when 70..89 then "bg-blue-500"
    when 50..69 then "bg-yellow-500"
    else "bg-red-500"
  end %>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8 mb-8">
    <div class="flex items-center gap-6 mb-8">
      <div class="w-24 h-24 rounded-full <%= score_color %> flex items-center justify-center text-white text-3xl font-bold">
        <%= score %>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-gray-900">Overall Score: <%= score %>/100</h2>
        <p class="text-gray-600">Grade: <%= grade %></p>
        <p class="text-sm text-gray-500 mt-1">Based on ATS-friendly factors: contact info, summary, skills, experience, education, and formatting.</p>
      </div>
    </div>

    <h3 class="font-semibold text-gray-900 mb-4">Score Breakdown</h3>
    <div class="space-y-4">
      <% analysis[:breakdown].each do |key, data| %>
        <div>
          <div class="flex justify-between text-sm mb-1">
            <span><%= data[:label] %></span>
            <span><%= data[:score] %>/<%= data[:max] %></span>
          </div>
          <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
            <div class="h-full bg-blue-500 rounded-full" style="width: <%= (data[:score].to_f / data[:max] * 100).round %>%"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if analysis[:suggestions].any? %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
      <h3 class="font-semibold text-gray-900 mb-4">Suggestions to Improve Your Score</h3>
      <ul class="space-y-3">
        <% analysis[:suggestions].each do |suggestion| %>
          <li class="flex items-start gap-3">
            <span class="text-amber-500 mt-0.5">•</span>
            <span class="text-gray-700"><%= suggestion %></span>
          </li>
        <% end %>
      </ul>
      <%= link_to "Edit Resume", edit_resume_path, class: "inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition" %>
    </div>
  <% else %>
    <div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center">
      <p class="text-green-800 font-medium">Great job! Your resume looks ATS-friendly.</p>
      <p class="text-green-700 text-sm mt-1">Keep it updated by adding new achievements and skills as you gain experience.</p>
      <%= link_to "Edit Resume", edit_resume_path, class: "inline-block mt-4 text-green-700 hover:text-green-900 font-medium" %>
    </div>
  <% end %>
</div>
