
<body>
	<%= render "hero" %>

<% if @featured_article %>
	<section class="py-16 bg-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-12 ">
				<h2 class="text-2xl font-bold text-gray-900 mb-2">Featured Article</h2>
				<p class="text-gray-600">Our most popular and impactful career advice</p>
			</div>
			<%= render "featured_article", featured_article: @featured_article %>
		</div>
	</section>
<% end %>
	<section class="py-16 bg-gray-50">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-12 ">
				<h2 class="text-3xl font-bold text-gray-900 mb-2">Latest Articles</h2>
				<p class="text-gray-600">Stay updated with the newest career insights and job market trends</p>
			</div>

			<%= render "latest_articles", articles: @articles, pagy: @pagy %>
		</div>
	</section>

	<%#= render "newsletter_signup" %>
	<%= render "shared/footer" %>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Mobile menu toggle
			document.getElementById('mobile-menu-btn').addEventListener('click', function() {
				const menu = document.getElementById('mobile-menu');
				menu.classList.toggle('hidden');
			});

			// Close mobile menu when clicking outside
			document.addEventListener('click', function(event) {
				const menu = document.getElementById('mobile-menu');
				const btn = document.getElementById('mobile-menu-btn');

				if (!menu.contains(event.target) && !btn.contains(event.target)) {
						menu.classList.add('hidden');
				}
			});
		});
	</script>
</body>


<% content_for :structured_data do %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "Free Resume Builder Blog",
      "description": "Stay updated with the newest career insights and job market trends",
      "url": "https://freeresumebuilderapp.com/blog",
      "author": {
        "@type": "Person",
        "name": "Pedro Monsalve"
      }
      "publisher": {
        "@type": "Organization",
        "name": "Free Resume Builder App"
      }
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://freeresumebuilderapp.com/blog"
      }
      "keywords": "career advice, job market trends, resume building, job search"
    }
  </script>
<% end %>
