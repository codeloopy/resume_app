<% if @article %>
  <body>
    <%= render "articles/components/reading_progress_bar" %>
    <%= render "articles/components/breadcrumbs" %>

    <!-- Article Header -->
    <section class="py-12 bg-gray-50/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <article class="fade-in">
          <div class="flex items-center mb-6">
            <span class="bg-<%= @article.color %>-100 text-<%= @article.color %>-800 px-3 py-1.5 rounded-full text-sm font-medium"><%= @article.category %></span>
            <span class="text-gray-500 ml-4 text-sm flex items-center">
              <i class="fas fa-clock mr-1"></i>
              <%= @article.read_time %> min read
            </span>
            <span class="text-gray-500 ml-4 text-sm"><%= @article.published_at.strftime("%B %d, %Y") %></span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight tracking-tight">
            <%= @article.title %>
          </h1>

          <div class="flex items-center justify-between border-t border-gray-200 pt-6">
            <%= render "articles/components/author_info", article: @article %>
            <%= render "articles/components/social_share" %>
          </div>
        </article>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-4 gap-12">
          <div class="lg:col-span-1">
            <div class="sticky-sidebar">
              <%= render "articles/components/cta_box" %>
            </div>
          </div>

          <!-- Main Content -->
          <div class="lg:col-span-3">
            <div class="article-content fade-in">
              <!-- Featured Image -->
              <div class="mb-8">
                <div class="h-64 bg-gradient-to-r from-<%= @article.color %>-200 to-<%= @article.color %>-300 rounded-2xl flex items-center justify-center relative overflow-hidden">
                  <div class="text-center z-10">
                    <i class="fas fa-<%= @article.icon %> text-6xl text-primary mb-4"></i>
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-secondary/5"></div>
                </div>
              </div>

              <p><%= @article.body %></p>

              <!-- Call to Action -->
              <%= render "articles/components/cta_box_large" %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-gray-50/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 fade-in">
          <h2 class="text-3xl font-bold text-gray-900 mb-4 tracking-tight">Related Articles</h2>
          <p class="text-gray-600">Continue your career journey with these helpful guides</p>
        </div>

        <%= render "articles/latest_articles", articles: @latest_articles %>
      </div>
    </section>

    <%= render "shared/footer" %>
  </body>
<% end %>
