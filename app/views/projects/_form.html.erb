<%= form_with model: project, local: true do |f| %>
  <% if project.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-red-800 font-medium mb-2">Please fix the following errors:</h3>
      <ul class="text-red-700 text-sm">
        <% project.errors.full_messages.each do |message| %>
          <li>• <%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :title, "Project Title", class: "block text-gray-700 font-semibold mb-2" %>
    <%= f.text_field :title, class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "e.g., E-commerce Platform, Mobile App, etc." %>
  </div>

  <div class="mb-4">
    <%= f.label :description, "Description", class: "block text-gray-700 font-semibold mb-2" %>
    <%= f.text_area :description, rows: 4, class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "Describe the project, technologies used, your role, and key achievements..." %>
  </div>

  <div class="mb-4">
    <%= f.label :url, "Project URL (Optional)", class: "block text-gray-700 font-semibold mb-2" %>
    <%= f.url_field :url, class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder: "https://github.com/username/project or https://project-demo.com" %>
    <p class="text-xs text-gray-500 mt-1">Link to live demo, GitHub repository, or portfolio</p>
  </div>

  <div class="flex justify-between items-center">
    <%= link_to "Cancel", resume_wizard_path(:projects), class: "text-gray-600 hover:text-gray-800 font-medium" %>
    <%= f.submit project.new_record? ? "Add Project" : "Update Project", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition duration-200" %>
  </div>
<% end %>
