<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6 flex justify-between items-center">
    <%= link_to "← Back to Tracker", resume_job_applications_path(@resume), class: "text-gray-600 hover:text-gray-900 font-medium text-sm" %>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_resume_job_application_path(@resume, @job_application), class: "inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm py-2" %>
      <%= button_to "Delete", resume_job_application_path(@resume, @job_application), method: :delete, form: { data: { turbo_confirm: "Remove this application?" } }, class: "text-red-600 hover:text-red-800 font-medium text-sm" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @job_application.display_title %></h1>
        <p class="text-gray-500 text-sm mt-1"><%= @job_application.company %> · <%= @job_application.role %></p>
      </div>
      <span class="inline-flex px-3 py-1 rounded-full text-sm font-medium <%= status_badge_class(@job_application.status) %>">
        <%= @job_application.status_label %>
      </span>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <% if @job_application.applied_at %>
        <div>
          <dt class="text-gray-500 font-medium">Applied</dt>
          <dd class="text-gray-900"><%= @job_application.applied_at.strftime("%B %d, %Y") %></dd>
        </div>
      <% end %>
      <% if @job_application.next_follow_up_at %>
        <div>
          <dt class="text-gray-500 font-medium">Next follow-up</dt>
          <dd class="text-gray-900"><%= @job_application.next_follow_up_at.strftime("%B %d, %Y") %></dd>
        </div>
      <% end %>
    </dl>

    <% if @job_application.notes.present? %>
      <div class="mt-6 pt-6 border-t border-gray-200">
        <h3 class="text-sm font-medium text-gray-700 mb-2">Notes</h3>
        <div class="text-gray-900 whitespace-pre-wrap"><%= @job_application.notes %></div>
      </div>
    <% end %>
  </div>
</div>
