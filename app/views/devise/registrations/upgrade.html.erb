<div class="max-w-md mx-auto my-4">
  <h1 class="text-3xl font-bold mb-6 text-center">Complete Your Account</h1>

  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm text-blue-700">
          Great news! Your resume is ready. Create a free account to download your PDF, get a public link, and save your progress.
        </p>
      </div>
    </div>
  </div>

  <%= form_for(@resource, as: resource_name, url: upgrade_guest_user_path, method: :put) do |f| %>
    <%= render "devise/shared/error_messages", resource: @resource %>

    <div class="mb-4">
      <%= f.label :email, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "john.doe@example.com" %>
    </div>

    <div class="mb-4">
      <%= f.label :first_name, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :first_name, value: current_user.first_name, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "John" %>
    </div>

    <div class="mb-4">
      <%= f.label :last_name, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :last_name, value: current_user.last_name, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "Doe" %>
    </div>

    <div class="mb-4">
      <%= f.label :phone, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :phone, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "+1234567890" %>
    </div>

    <div class="mb-4">
      <%= f.label :location, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :location, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "i.e. City, State, Country" %>
    </div>

    <div class="mb-4">
      <%= f.label :linked_in_url, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.url_field :linked_in_url, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "https://www.linkedin.com/in/john-doe" %>
    </div>

    <div class="mb-4">
      <%= f.label :github_url, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.url_field :github_url, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "https://github.com/john-doe" %>
    </div>

    <div class="mb-4">
      <%= f.label "Portfolio or Other URL", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.url_field :portfolio, class: "w-full p-2 border border-gray-300 rounded-md bg-white", placeholder: "https://john-doe.com" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block text-gray-700 font-semibold mb-2" %>
      <em class="text-sm text-gray-600">(Choose a password for your account)</em>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full p-2 border border-gray-300 rounded-md bg-white" %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full p-2 border border-gray-300 rounded-md bg-white" %>
    </div>

    <div class="actions">
      <%= f.submit "Complete My Account", class: 'w-full text-white bg-gradient-to-br from-purple-600 to-blue-500 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-blue-300 dark:focus:ring-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center my-4' %>
    </div>
  <% end %>

  <div class="mt-6 text-center">
    <p class="text-sm text-gray-600">
      Already have an account?
      <%= link_to "Sign in", new_user_session_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </p>
  </div>
</div>
